PUBLIC_SITE_URL=https://iguanacomedy.com
PUBLIC_KINTANA_API_KEY=kpa_live_xxxxxxxxxxxxxxxxxxxxxxxx
PUBLIC_KINTANA_BASE_URL=https://kintana.app
PUBLIC_KINTANA_SHOW_REQUEST_FORM_ID=paste-contact-form-id
# Optional: paste `data-token="..."` from Kintana → Websites → your external site → tracker snippet (recommended—avoid exposing the publish key in HTML). If unset, the publish key above is used for the tracker script instead.
# PUBLIC_KINTANA_TRACKER_TOKEN=

# Server-only workspace secret (`kpa_secret_…`). Set only on your host (Dokploy, Vercel server env, etc.)—never prefixed with PUBLIC_ or exposed to browsers. Enables SDK workspace features where the codebase uses `createKintanaClientFromEnv` with `secretApiKey`.
# KINTANA_SECRET_API_KEY=

# Add a plaintext `subject` field to that form—`/contact/` appends query ?subject=TAG so routing stays sane.
