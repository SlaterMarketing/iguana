---
export const prerender = true;

import Base from "./Base.astro";

const props = Astro.props as {
  frontmatter?: {
    title?: string;
    description?: string;
    /** e.g. `{ hotels: "/hotels-and-resorts/" }` — redirects `/#hotels` to the dedicated page (fragments are not visible to hosting redirects). */
    hashRedirects?: Record<string, string>;
  };
};

const fm = props.frontmatter ?? {};
const title = typeof fm.title === "string" ? fm.title : "Iguana Comedy";
const description = typeof fm.description === "string" ? fm.description : undefined;

const rawRedirects = fm.hashRedirects;
const hashRedirects =
  rawRedirects && typeof rawRedirects === "object" && !Array.isArray(rawRedirects)
    ? (rawRedirects as Record<string, string>)
    : null;
const hashRedirectJson =
  hashRedirects && Object.keys(hashRedirects).length > 0 ? JSON.stringify(hashRedirects) : null;
---

<Base title={title} description={description} narrow>
  <article class="prose-ish space-y-8 text-neutral-700">
    <slot />
  </article>
  {
    hashRedirectJson ? (
      <script is:inline data-redirects={hashRedirectJson}>
        (function () {
          var el = document.currentScript;
          var raw = el && el.getAttribute("data-redirects");
          if (!raw) return;
          try {
            var map = JSON.parse(raw);
            var key = location.hash.replace(/^#/, "");
            if (key && map[key]) location.replace(map[key]);
          } catch (_) {}
        })();
      </script>
    ) : null
  }
</Base>

<style>
  .prose-ish :global(h2) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.95rem, 3vw + 1rem, 2.85rem);
    color: #0f1613;
    letter-spacing: -0.01em;
  }
  .prose-ish :global(h3) {
    margin-top: 2.65rem;
    font-size: 0.74rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.35em;
    color: rgb(133 143 146);
  }
  .prose-ish :global(p) {
    margin-top: 1.15rem;
    line-height: 1.74rem;
    font-size: 1.05rem;
  }
</style>
