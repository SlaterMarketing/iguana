---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

interface Props {
  title?: string;
  description?: string;
  /** Homepage hero sits under a fixed transparent nav */
  transparentHeader?: boolean;
  /** Narrow inner column for prose pages */
  narrow?: boolean;
  /** Homepage hero: full-bleed main, no extra chrome spacing */
  flushMain?: boolean;
}

const {
  title = "Iguana Comedy",
  description = "International English stand‑up comedy across Cancún, Playa del Carmen, Tulum, Cozumel & the Riviera Maya.",
  transparentHeader = false,
  narrow = false,
  flushMain = false,
} = Astro.props;

function escapeAttr(v: string) {
  return v.replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/'/g, "&#39;");
}

const TRACK_BASE = import.meta.env.PUBLIC_KINTANA_BASE_URL?.replace(/\/$/, "") ?? "";
/** Prefer the snippet token from Website → external site (JWT); falls back to publish key so ingest still works. */
const TRACK_TOKEN =
  import.meta.env.PUBLIC_KINTANA_TRACKER_TOKEN?.trim() ||
  import.meta.env.PUBLIC_KINTANA_API_KEY?.trim() ||
  "";
const trackerMarkup =
  TRACK_BASE && TRACK_TOKEN
    ? `<script async src="${escapeAttr(TRACK_BASE)}/_t/k.js" data-token="${escapeAttr(
        TRACK_TOKEN
      )}" data-api-base="${escapeAttr(TRACK_BASE)}"><\\/script>`
    : "";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-white text-neutral-900 antialiased">
    <Header transparent={transparentHeader} pathname={Astro.url.pathname} />
    <main
      class:list={[
        flushMain ? "relative w-full" : narrow ? "mx-auto max-w-6xl px-4 pb-20 pt-8 sm:px-6 lg:pt-14" : "relative w-full",
      ]}
    >
      <slot />
    </main>

    {!transparentHeader ? <div class="h-px w-full bg-black/10" aria-hidden="true" /> : null}

    <Footer />

    {trackerMarkup ? <span aria-hidden="true" class="hidden" set:html={trackerMarkup} /> : null}
  </body>
</html>
