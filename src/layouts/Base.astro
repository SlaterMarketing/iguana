---
import "../styles/global.css";
// Fonts are self-hosted (no Google Fonts request): hashed files under /_astro/, cached for a year by nginx.
import bebasLatin from "@fontsource/bebas-neue/files/bebas-neue-latin-400-normal.woff2?url";
import bebasLatinExt from "@fontsource/bebas-neue/files/bebas-neue-latin-ext-400-normal.woff2?url";
import dmSansLatin from "@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url";
import dmSansLatinExt from "@fontsource-variable/dm-sans/files/dm-sans-latin-ext-wght-normal.woff2?url";
import dmSansLatinItalic from "@fontsource-variable/dm-sans/files/dm-sans-latin-wght-italic.woff2?url";
import dmSansLatinExtItalic from "@fontsource-variable/dm-sans/files/dm-sans-latin-ext-wght-italic.woff2?url";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { site } from "../content/site";
import { getKintanaEnv } from "../lib/kintana-env";
import { getLocale, getCanonicalUrl, getAlternateUrls, type Locale } from "../i18n/locale";
import { t } from "../i18n/ui";

interface Props {
  title?: string;
  description?: string;
  /** Overlay hero pages: nav floats over the hero and scrolls away with the page */
  transparentHeader?: boolean;
  /** Narrow inner column for prose pages */
  narrow?: boolean;
  /** Homepage hero: full-bleed main, no extra chrome spacing */
  flushMain?: boolean;
  ogImage?: string;
  noindex?: boolean;
}

const locale = getLocale(Astro);

const {
  title = t(locale, "seo.defaultTitle"),
  description = t(locale, "seo.defaultDescription"),
  transparentHeader = false,
  narrow = false,
  flushMain = false,
  ogImage,
  noindex = false,
} = Astro.props;

function escapeAttr(v: string) {
  return v.replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/'/g, "&#39;");
}

const canonicalUrl = getCanonicalUrl(Astro);
const alternateUrls = getAlternateUrls(Astro);
const ogLocale = t(locale, "seo.ogLocale");
const siteOrigin = Astro.site?.origin ?? "https://iguanacomedy.com";
// Brand share image per language (scripts/make-banners.py), 1200x630; the stock hero photo used to stand in for it.
const defaultOgImage = `/media/og-default-${locale}.jpg`;
const shareImage = new URL(ogImage ?? defaultOgImage, siteOrigin).href;
const shareImageIsDefault = !ogImage;

const { apiKey, baseUrl, trackerToken } = getKintanaEnv();
const TRACK_BASE = baseUrl.replace(/\/$/, "");
const TRACK_TOKEN = trackerToken || apiKey;
// Clicky via the first-party nginx proxy; only set on hosts that run that proxy (see ansible/files/nginx.conf.j2).
const clickySiteId = import.meta.env.PUBLIC_CLICKY_SITE_ID?.trim();
const clickyScriptPath = import.meta.env.PUBLIC_CLICKY_SCRIPT_PATH?.trim();

const LATIN = "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD";
const LATIN_EXT = "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF";
// Bebas Neue is `block`: the headline waits for it (preloaded, so briefly) instead of drawing in a fallback font and
// reflowing when it arrives, which measured as a 0.25 layout shift on desktop. Body text keeps `swap`.
const fontFaces = [
  ["Bebas Neue", bebasLatin, "400", "normal", "block", LATIN],
  ["Bebas Neue", bebasLatinExt, "400", "normal", "block", LATIN_EXT],
  ["DM Sans", dmSansLatin, "100 1000", "normal", "swap", LATIN],
  ["DM Sans", dmSansLatinExt, "100 1000", "normal", "swap", LATIN_EXT],
  ["DM Sans", dmSansLatinItalic, "100 1000", "italic", "swap", LATIN],
  ["DM Sans", dmSansLatinExtItalic, "100 1000", "italic", "swap", LATIN_EXT],
]
  .map(
    ([family, url, weight, style, display, range]) =>
      `@font-face{font-family:"${family}";src:url(${url}) format("woff2");font-weight:${weight};font-style:${style};font-display:${display};unicode-range:${range}}`,
  )
  .join("");

const trackerMarkup =
  TRACK_BASE && TRACK_TOKEN
    ? `<script async src="${escapeAttr(TRACK_BASE)}/_t/k.js" data-token="${escapeAttr(
        TRACK_TOKEN
      )}" data-api-base="${escapeAttr(TRACK_BASE)}"></` + `script>`
    : "";
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Canonical & Hreflang -->
    <link rel="canonical" href={canonicalUrl} />
    {
      alternateUrls.map((alt) => (
        <link rel="alternate" hreflang={alt.locale} href={alt.url} />
      ))
    }
    {alternateUrls.length > 1 && <link rel="alternate" hreflang="x-default" href={alternateUrls.find((alt) => alt.locale === "en")?.url} />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={locale === "es" ? "en_US" : "es_MX"} />
    <meta property="og:site_name" content={t(locale, "seo.siteName")} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:alt" content={title} />
    {shareImageIsDefault && <meta property="og:image:width" content="1200" />}
    {shareImageIsDefault && <meta property="og:image:height" content="630" />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={title} />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: t(locale, "seo.siteName"),
      url: siteOrigin,
      inLanguage: locale,
    })} />

    <link rel="icon" type="image/webp" href={site.faviconUrl} />
    <link rel="apple-touch-icon" href={site.faviconUrl} />
    <link rel="preload" href={bebasLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={dmSansLatin} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces} />
    {clickySiteId && clickyScriptPath ? <script is:inline async data-id={clickySiteId} src={clickyScriptPath}></script> : null}
  </head>
  <body class="relative bg-white text-neutral-900 antialiased">
    <Header transparent={transparentHeader} pathname={Astro.url.pathname} locale={locale} />
    <main
      class:list={[
        flushMain ? "relative w-full" : narrow ? "mx-auto max-w-page px-4 pb-20 pt-8 sm:px-6 lg:pt-14" : "relative w-full",
      ]}
    >
      <slot />
    </main>

    {!transparentHeader ? <div class="h-px w-full bg-black/10" aria-hidden="true" /> : null}

    <Footer locale={locale} />

    {trackerMarkup ? <span aria-hidden="true" class="hidden" set:html={trackerMarkup} /> : null}
  </body>
</html>
