---
import Base from "../layouts/Base.astro";
import HomeHero from "../components/home/HomeHero.astro";
import HomePageSections from "../components/home/HomePageSections.astro";
import { heroCityChoices, site } from "../content/site";
import { loadHomePageData } from "../lib/home-page-data";

const redirectCity = Astro.url.searchParams.get("city")?.trim();
if (redirectCity) {
  return Astro.redirect(`/locations/${redirectCity}/`);
}

const pageData = await loadHomePageData();

const cityPickerChoices = [
  { slug: "", label: "Whole coastline" },
  ...heroCityChoices.filter((entry) => entry.slug !== ""),
];
---

<Base
  transparentHeader
  flushMain
  narrow={false}
  title="Iguana Comedy · English comedy across the Riviera Maya"
  description={site.shortTagline}
>
  <HomeHero
    showsHref="/events/"
    pickerChoices={cityPickerChoices}
    activeCitySlug=""
  />
  <HomePageSections {...pageData} apiConfigured={pageData.hasCredentials} />
</Base>
