---
/**
 * Fallback when middleware is not in the chain; same rules as middleware for `/`.
 */
export const prerender = false;

import { LOCALE_PREFERENCE_COOKIE, resolveRootLocale } from "../lib/locale-preference";

const locale = resolveRootLocale({
  preferenceCookie: Astro.cookies.get(LOCALE_PREFERENCE_COOKIE)?.value,
  acceptLanguage: Astro.request.headers.get("Accept-Language"),
});
return Astro.redirect(`/${locale}/`, 302);
---
