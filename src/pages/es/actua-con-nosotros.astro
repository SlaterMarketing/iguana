---
import Base from "../../layouts/Base.astro";
import Cta from "../../components/Cta.astro";
import ExperienceStatsStrip from "../../components/ExperienceStatsStrip.astro";
import PerformFaq from "../../components/perform/PerformFaq.astro";
import { ContactFormIsland } from "../../components/ContactFormIsland";
import {
  getPerformPage,
  getPerformOffers,
  getPerformFaq,
} from "../../content/perform-with-us";
import { site } from "../../content/site";
import { getKintanaEnv } from "../../lib/kintana-env";
import { t } from "../../i18n/ui";
import { localizePath } from "../../i18n/routes";

const locale = "es";
const performPage = getPerformPage(locale);
const performOffers = getPerformOffers(locale);
const performFaq = getPerformFaq(locale);

const { apiKey, baseUrl, hasCredentials } = getKintanaEnv();
const endpointSlug = "perform-with-us";
const prefills = { subject: "perform" };
---

<Base
  narrow={false}
  title={`${performPage.title} · Iguana Comedy`}
  description={performPage.description}
>
  <section class="relative isolate overflow-hidden bg-brand-hover px-6 py-28 text-center text-white sm:py-36">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.12]"
      style="background-image: repeating-linear-gradient(-12deg, transparent, transparent 18px, rgba(255,255,255,0.35) 18px, rgba(255,255,255,0.35) 20px);"
      aria-hidden="true"
    ></div>
    <h1
      class="relative z-10 font-display text-[clamp(3rem,8vw,6.25rem)] uppercase leading-[0.95] tracking-wide"
      style="font-family: var(--font-display);"
    >
      {performPage.title}
    </h1>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-20 text-center sm:py-28">
    {performPage.intro.map((paragraph) => (
      <p class="mt-8 text-lg leading-relaxed text-neutral-800 first:mt-0 sm:text-xl">{paragraph}</p>
    ))}
  </section>

  <section class="mx-auto max-w-[118rem] px-6 pb-20">
    <div class="grid gap-4 sm:grid-cols-3">
      {performPage.galleryImages.map((src) => (
        <div class="overflow-hidden rounded-[2rem] shadow-[0_16px_48px_rgba(0,0,0,0.1)]">
          <img src={src} alt="" class="aspect-[4/3] size-full object-cover" loading="lazy" decoding="async" />
        </div>
      ))}
    </div>
  </section>

  <section class="border-t border-black/10 bg-neutral-50">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center sm:py-28">
      <h2
        class="font-display text-3xl uppercase leading-[1.08] text-neutral-950 sm:text-4xl"
        style="font-family: var(--font-display);"
      >
        {performPage.pilgrimageHeading}
      </h2>
      <p class="mx-auto mt-8 max-w-2xl text-lg leading-relaxed text-neutral-700">{performPage.pilgrimageBody}</p>
      <div class="mx-auto mt-14 max-w-3xl">
        <ExperienceStatsStrip locale={locale} />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[118rem] px-6 py-20 sm:py-28">
    <h2
      class="text-center font-display text-3xl uppercase text-neutral-950 sm:text-4xl"
      style="font-family: var(--font-display);"
    >
      {performPage.offersHeading}
    </h2>
    <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        performOffers.map((offer) => (
          <li
            class:list={[
              "flex min-h-[8.5rem] items-center justify-center rounded-[1.75rem] px-6 py-8 text-center font-display text-xl uppercase leading-snug tracking-wide sm:text-2xl",
              "highlight" in offer && offer.highlight
                ? "bg-brand-hover text-white"
                : "border border-black/10 bg-white text-neutral-950",
            ]}
            style="font-family: var(--font-display);"
          >
            {offer.title}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-[118rem] border-t border-black/10 px-6 py-20 sm:py-28">
    <PerformFaq faq={performFaq} />
  </section>

  <section id="apply" class="relative isolate scroll-mt-24 overflow-hidden">
    <img
      src={performPage.formBackdrop}
      alt=""
      class="absolute inset-0 size-full object-cover"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-neutral-950/50" aria-hidden="true" />
    <div class="relative z-10 mx-auto max-w-3xl px-6 py-24 sm:py-32">
      <div class="rounded-[2.5rem] bg-white px-8 py-12 shadow-[0_24px_80px_rgba(0,0,0,0.25)] sm:px-12 sm:py-14">
        <h2
          class="text-center font-display text-4xl text-brand-hover sm:text-5xl"
          style="font-family: var(--font-display); color: var(--color-brand-hover);"
        >
          {performPage.formHeading}
        </h2>
        <p class="mx-auto mt-6 max-w-xl text-center text-neutral-700">{performPage.formIntro}</p>

        <div class="mt-12">
          {
            !hasCredentials ? (
              <p class="rounded-3xl border border-amber-200 bg-amber-50 px-6 py-8 text-center text-neutral-950">
                {t(locale, "perform.formUnavailable").replace("{email}", site.email)}
              </p>
            ) : (
              <ContactFormIsland client:load apiKey={apiKey} baseUrl={baseUrl} endpointSlug={endpointSlug} prefills={prefills} hideHeading />
            )
          }
        </div>

        <p class="mt-12 text-center text-xs font-semibold uppercase tracking-[0.4em] text-neutral-500">
          {t(locale, "perform.orMessageSocials")}
        </p>
        <nav class="mt-6 flex flex-wrap justify-center gap-x-10 gap-y-4 text-sm text-neutral-800">
          <a class="hover:text-brand" href={site.instagramUrl} target="_blank" rel="noreferrer noopener">
            Instagram
          </a>
          <a class="hover:text-brand" href={site.facebookUrl} target="_blank" rel="noreferrer noopener">
            Facebook
          </a>
          <a
            class="hover:text-brand"
            href={`https://wa.me/${site.whatsappE164}`}
            target="_blank"
            rel="noreferrer noopener"
          >
            WhatsApp · {site.whatsappDisplay}
          </a>
        </nav>
      </div>
    </div>
  </section>

  <Cta
    eyebrow={t(locale, "cta.eyebrow.audiences")}
    headline={t(locale, "cta.headline.readyToLaugh")}
    body={t(locale, "cta.body.perform")}
    ctaHref={localizePath(locale, "events")}
    secondaryHref={localizePath(locale, "contact")}
    secondaryLabel={t(locale, "cta.secondaryLabel.talkWithUs")}
    locale={locale}
  />
</Base>
