---
/**
 * The club membership is not on sale. It was built on the Kintana-era subscription and the club does not want
 * to run one from the site for now, so rather than leave a page selling something nobody can join, the route
 * 301s to the merch desk: the one thing here a visitor can actually buy.
 *
 * The route key stays in `src/i18n/routes.ts` because the account screens still link to it after a Stripe
 * cancel, and an old newsletter or an indexed search result still points here.
 */
import { localizePath } from "../../i18n/routes";

return Astro.redirect(localizePath("es", "store"), 301);
---
