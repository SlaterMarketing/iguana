---
import Base from "../../../layouts/Base.astro";
import type { KintanaPublicArtistEmbed } from "@kintana/sdk";
import ComedianTile from "../../../components/ComedianTile.astro";
import { logKintanaError, logKintanaSuccess } from "../../../lib/kintana-error";
import { createLocalizedKintanaClient, getKintanaEnv } from "../../../lib/kintana-env";
import { t } from "../../../i18n/ui";

const locale = "es";

const { apiKey, baseUrl, hasCredentials } = getKintanaEnv();

let artists: KintanaPublicArtistEmbed[] = [];
let rosterFailed = false;

if (hasCredentials) {
  try {
    artists = await createLocalizedKintanaClient(locale).listArtists({
      limit: 100,
    });
    logKintanaSuccess("listArtists /comedians", artists.length);
  } catch (err) {
    logKintanaError("listArtists /comedians", err);
    rosterFailed = true;
    artists = [];
  }
}
---

<Base narrow={false} transparentHeader={false} title={`${t(locale, "comedians.title")} · Iguana Comedy`}>
  <section class="mx-auto max-w-page px-6 pb-32 pt-20">
    <p class="text-center text-xs font-semibold uppercase tracking-[0.45em] text-neutral-500">{t(locale, "comedians.directory")}</p>
    <div class="mt-8 flex flex-col items-center gap-6 text-center">
      <h1 class="font-display text-5xl leading-tight text-neutral-950 lg:text-[3.7rem]" style={`font-family: var(--font-display);`}>{t(locale, "comedians.title")}</h1>
      <p class="max-w-2xl text-lg text-neutral-600">
        {t(locale, "comedians.description")}
      </p>
      <a
        class="inline-flex min-h-11 items-center justify-center rounded-full bg-neutral-950 px-6 py-3 text-xs font-semibold uppercase tracking-[0.25em] text-white hover:bg-brand-hover"
        href={`/comic/?lang=${locale}`}
      >
        {t(locale, "comedians.become")}
      </a>
    </div>

    {
      !(apiKey && baseUrl) ? (
        <p class="mt-16 rounded-3xl border border-amber-200 bg-amber-50 px-6 py-8 text-neutral-950">{t(locale, "comedians.noCredentials")}</p>
      ) : rosterFailed ? (
        <p class="mt-16 rounded-3xl border border-red-200 bg-red-50 px-6 py-8 text-neutral-950">
          {t(locale, "comedians.error")}
        </p>
      ) : artists.length === 0 ? (
        <p class="mt-16 text-neutral-600">{t(locale, "comedians.empty")}</p>
      ) : (
        <div class="mt-20 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
          {artists.map((artist) => (
            <ComedianTile artist={artist} locale={locale} />
          ))}
        </div>
      )
    }

    <div class="mx-auto mt-24 max-w-2xl rounded-3xl bg-neutral-50 px-6 py-10 text-center">
      <h2 class="font-display text-3xl text-neutral-950" style={`font-family: var(--font-display);`}>{t(locale, "comedians.become")}</h2>
      <p class="mx-auto mt-4 max-w-xl text-neutral-700">{t(locale, "comedians.becomeBody")}</p>
      <a
        class="mt-6 inline-flex min-h-11 items-center justify-center rounded-full bg-neutral-950 px-6 py-3 text-xs font-semibold uppercase tracking-[0.25em] text-white hover:bg-brand-hover"
        href={`/comic/?lang=${locale}`}
      >
        {t(locale, "comedians.becomeCta")}
      </a>
    </div>
  </section>
</Base>
