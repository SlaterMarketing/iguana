---
import Base from "../../../layouts/Base.astro";
import { AccountPage } from "../../../components/account/AccountPage";
import { site } from "../../../content/site";
import { getKintanaEnv, hasKintanaCredentials } from "../../../lib/kintana-env";

const locale = "es" as const;
const { apiKey, baseUrl } = getKintanaEnv();
---

<Base
  narrow
  title={`Perfil · ${site.name}`}
  description="Actualiza tu perfil de Iguana Comedy."
  noindex
>
  {
    hasKintanaCredentials() ? (
      <AccountPage client:load apiKey={apiKey!} baseUrl={baseUrl!} locale={locale} view="profile" />
    ) : (
      <p class="text-muted">El acceso a la cuenta aún no está configurado.</p>
    )
  }
</Base>
