---
import Base from "../../layouts/Base.astro";
import HomeHero from "../../components/home/HomeHero.astro";
import HomePageSections from "../../components/home/HomePageSections.astro";
import OpenMicHeroBadge from "../../components/home/OpenMicHeroBadge.astro";
import NewsletterSignup from "../../components/NewsletterSignup.astro";
import { heroCityChoices, siteMessages } from "../../content/site";
import { loadHomePageData } from "../../lib/home-page-data";
import { localizePath } from "../../i18n/routes";
import { t } from "../../i18n/ui";

const locale = "es";

const redirectCity = Astro.url.searchParams.get("city")?.trim();
if (redirectCity) {
  return Astro.redirect(localizePath(locale, "cityDetail", { city: redirectCity }));
}

const pageData = await loadHomePageData(undefined, locale);

const cityPickerChoices = [
  { slug: "", label: "Toda la costa" },
  ...heroCityChoices.filter((entry) => entry.slug !== ""),
];
---

<Base
  transparentHeader
  flushMain
  narrow={false}
  title="Iguana Comedy · Comedia en inglés en la Riviera Maya"
  description={siteMessages[locale].shortTagline}
>
  <HomeHero
    locale={locale}
    showsHref={localizePath(locale, "events")}
    pickerChoices={cityPickerChoices}
    activeCitySlug=""
    eyebrow={t(locale, "home.eyebrow")}
    headlineLine1="Stand-up internacional"
    headlineLine2Prefix="comedia en "
    headlineLine2Static="Playa del Carmen"
    ctaLabel="Comprar boleto"
    spotlightLabel="Ciudad destacada"
  >
    <OpenMicHeroBadge slot="announcement" locale={locale} events={pageData.eventsPool} />
    <NewsletterSignup slot="aside" locale={locale} tone="dark" />
  </HomeHero>
  <HomePageSections {...pageData} apiConfigured={pageData.hasCredentials} locale={locale} />
</Base>
