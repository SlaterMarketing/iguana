---
import Base from "../../layouts/Base.astro";
import { createKintanaClient } from "@kintana/sdk";
import type { KintanaPublicArtistEmbed } from "@kintana/sdk";

import ComedianTile from "../../components/ComedianTile.astro";
import { logKintanaError, logKintanaSuccess } from "../../lib/kintana-error";

const apiKey = import.meta.env.PUBLIC_KINTANA_API_KEY;
const baseUrl = import.meta.env.PUBLIC_KINTANA_BASE_URL;

let artists: KintanaPublicArtistEmbed[] = [];
let rosterFailed = false;

if (apiKey && baseUrl) {
  try {
    artists = await createKintanaClient({ apiKey, baseUrl }).listArtists({
      limit: 100,
    });
    logKintanaSuccess("listArtists /comedians", artists.length);
  } catch (err) {
    logKintanaError("listArtists /comedians", err);
    rosterFailed = true;
    artists = [];
  }
}
---

<Base narrow={false} transparentHeader={false} title="Wall of comedians · Iguana Comedy">
  <section class="mx-auto max-w-6xl px-6 pb-32 pt-20">
    <p class="text-xs font-semibold uppercase tracking-[0.45em] text-neutral-500">Directory</p>
    <div class="mt-10 grid gap-6 lg:flex lg:justify-between lg:gap-28">
      <h1 class="font-display text-5xl leading-tight text-neutral-950 lg:text-[3.7rem]" style={`font-family: var(--font-display);`}>Comedians we platform</h1>
      <p class="max-w-xl text-lg text-neutral-600">
        From headline imports to Playa regulars—we rotate guests across rooms so English comedy travellers always land on a fresh microphone.
      </p>
    </div>

    {
      !(apiKey && baseUrl) ? (
        <p class="mt-16 rounded-3xl border border-amber-200 bg-amber-50 px-6 py-8 text-neutral-950">Plug in ticketing credentials before this directory lights up.</p>
      ) : rosterFailed ? (
        <p class="mt-16 rounded-3xl border border-red-200 bg-red-50 px-6 py-8 text-neutral-950">
          Directory didn&apos;t load—check terminal output first; wrong publish credentials commonly return HTTP 401/403.
        </p>
      ) : artists.length === 0 ? (
        <p class="mt-16 text-neutral-600">Nothing published yet for performers on this ticketing account.</p>
      ) : (
        <div class="mt-20 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
          {artists.map((artist) => (
            <ComedianTile artist={artist} />
          ))}
        </div>
      )
    }
  </section>
</Base>
