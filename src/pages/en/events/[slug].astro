---
import EventDetailPage from "../../../components/events/EventDetailPage.astro";
import type { KintanaPublicEvent } from "@kintana/sdk";
import { createLocalizedKintanaClient, getKintanaEnv } from "../../../lib/kintana-env";
import { detailPageStatus } from "../../../lib/detail-page-status";
import { getLocale } from "../../../i18n/locale";

const locale = getLocale(Astro);
const slug = Astro.params.slug;

const { apiKey, baseUrl, hasCredentials } = getKintanaEnv();

let event: KintanaPublicEvent | null = null;
let lookupError: unknown = null;
if (hasCredentials && slug) {
  try {
    event = await createLocalizedKintanaClient(locale).getEvent(slug);
  } catch (err) {
    lookupError = err;
    event = null;
  }
}
// Unknown slug: 404, API trouble: 503 (never a 200 "not found" page that search engines index).
if (!event) Astro.response.status = detailPageStatus(lookupError, hasCredentials && Boolean(slug));
---

<EventDetailPage event={event} locale={locale} />
