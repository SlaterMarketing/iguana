---
import Base from "../../../layouts/Base.astro";
import { SignInForm } from "../../../components/account/SignInForm";
import { site } from "../../../content/site";
import { accountVerifyRedirectUrl, membershipPaths } from "../../../lib/kintana-auth";
import { getKintanaEnv, hasKintanaCredentials } from "../../../lib/kintana-env";
import { localizePath } from "../../../i18n/routes";

const locale = "en" as const;
const { apiKey, baseUrl } = getKintanaEnv();
const redirectUrl = accountVerifyRedirectUrl(locale);
const registerHref = Astro.url.search
  ? `${localizePath(locale, "accountRegister")}${Astro.url.search}`
  : membershipPaths(locale).accountRegister;
---

<Base
  narrow
  title={`Sign in · ${site.name}`}
  description="Sign in to your Iguana Comedy member account."
  noindex
>
  <div class="account-auth">
    <header class="account-auth-head">
      <h1 class="account-auth-title">Sign in</h1>
      <p class="account-auth-lead">Enter your email and we’ll send a link and a 6-digit code.</p>
    </header>

    {
      hasKintanaCredentials() ? (
        <>
          <SignInForm
            client:load
            apiKey={apiKey!}
            baseUrl={baseUrl!}
            locale={locale}
            redirectUrl={redirectUrl}
          />
          <p class="account-auth-switch">
            New here? <a href={registerHref}>Create an account</a>
          </p>
        </>
      ) : (
        <p class="account-status-copy">Account sign-in is not configured yet.</p>
      )
    }
  </div>
</Base>
