---
import Base from "../../layouts/Base.astro";
import { ContactFormIsland } from "../../components/ContactFormIsland";
import { getKintanaEnv } from "../../lib/kintana-env";
import { getLocale } from "../../i18n/locale";
import { t } from "../../i18n/ui";
import { localizePath } from "../../i18n/routes";

const locale = getLocale(Astro);

const { apiKey, baseUrl, formId, hasCredentials } = getKintanaEnv();

const subjectPrefill =
  Astro.url.searchParams.get("subject") ??
  Astro.url.searchParams.get("topic") ??
  "";

const prefills: Record<string, string> = {};
if (subjectPrefill.trim()) {
  prefills.subject = subjectPrefill.trim();
}

const subjectSummary: Record<string, { en: string; es: string }> = {
  general: { en: "General hello", es: "Hola general" },
  "private-events": { en: "Private show planning", es: "Planificación de show privado" },
  hotels: { en: "Hotels / resorts programming", es: "Programación para hoteles / resorts" },
  perform: { en: "I want to step onstage", es: "Quiero subir al escenario" },
  investors: { en: "Investor deck / partnership decks", es: "Deck de inversión / alianzas" },
};
---

<Base narrow transparentHeader={false} title={`${t(locale, "nav.contact")} · Iguana Comedy`} description={locale === "es" ? "Habla con nuestro equipo de producción sobre programación de comedia en la Riviera." : "Speak with our producing team about Riviera comedy programming."}>
  <section class="space-y-12">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.45em] text-neutral-500">{locale === "es" ? "Hablemos" : "Talk shop"}</p>
      <h1 class="mt-10 font-display text-5xl text-neutral-950" style={`font-family: var(--font-display);`}>
        {locale === "es" ? "Conversaciones dirigidas a los productores" : "Conversations routed to the producers"}
      </h1>
      <p class="mt-8 max-w-2xl text-lg text-neutral-600">
        {locale === "es"
          ? "Ya sea que estés buscando un fin de semana de bodas en destino, reuniendo compañeros de trabajo, reservando talento para hotel, proponiendo ángulos de inversión, o simplemente compartiendo notas de cariño, este formulario llega directo a nuestro calendario."
          : "Whether you're scouting a destination wedding weekend, corralling coworkers, booking hotel talent, pitching investment angles, or just sharing love notes—this form routes straight into our calendar."}
      </p>
      <details class="mt-8 rounded-3xl border border-neutral-300 bg-neutral-50 px-6 py-4 text-neutral-900">
        <summary class="cursor-pointer text-xs font-semibold uppercase tracking-[0.4em]">{locale === "es" ? "Prellenar tipo de consulta" : "Prefill enquiry type"}</summary>
        <nav class="mt-5 flex flex-wrap gap-x-10 gap-y-5 text-[0.7rem] uppercase tracking-[0.4em]" aria-label="Common enquiry intents">
          {
            Object.entries(subjectSummary).map(([slug, labels]) => (
              <a class="underline-offset-[0.5rem] hover:underline hover:text-brand" href={`${localizePath(locale, "contact")}?subject=${encodeURIComponent(slug)}`}>
                {labels[locale]}
              </a>
            ))
          }
        </nav>
      </details>
    </div>

    {!hasCredentials || !formId ? (
      <p class="rounded-3xl border border-amber-200 bg-amber-50 px-6 py-8 text-neutral-950">
        {locale === "es"
          ? "El formulario de consulta se conecta automáticamente una vez que lleguen las credenciales de ticketing."
          : "The enquiry form wires up automatically once ticketing credentials arrive."}
      </p>
    ) : (
      <ContactFormIsland client:load apiKey={apiKey} baseUrl={baseUrl} formId={formId} prefills={prefills} />
    )}
  </section>
</Base>
