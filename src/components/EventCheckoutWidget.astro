---
import { t } from "../i18n/ui";
import type { Locale } from "../i18n/locale";

interface Props {
  eventId: string;
  locale?: Locale;
  blocked?: boolean;
  /** The host page is already showing "N people reserved recently", so the iframe must not say it again. */
  ownDemandLine?: boolean;
  /** True when the checkout will draw a card form, which is three times the height of name-and-email. */
  collectsPayment?: boolean;
  /** Each extra ticket type adds a row above the form. */
  ticketTypes?: number;
  /** "card" when the host caps the checkout at a column width, so the form stops widening with the screen. */
  width?: "fluid" | "card";
  class?: string;
}

const {
  eventId,
  locale = "en",
  blocked = false,
  ownDemandLine = false,
  collectsPayment = false,
  ticketTypes = 1,
  width = "fluid",
  class: className,
} = Astro.props;

/**
 * The height to hold open while the iframe loads: the checkout's real content height, measured on the live
 * form at each width (2026-09-23). It is a placeholder, not a cage. The checkout reports when Stripe has
 * finished drawing, and from that moment the box fits its contents exactly, because a device that drew no
 * wallet row would otherwise keep the difference as white space above the Pay button.
 *
 * It cannot be one number. The form wraps to the width it is given, and that width does not follow the
 * viewport: below 1024px the checkout is full-bleed and gets wider as the screen does, at 1024px it drops
 * into a 27rem hero column and is suddenly narrow again. So the reserve tracks the same breakpoints the
 * layout uses, and holds the tallest case in each, which is the one with a wallet row. A device with no
 * wallet is left a little extra grey inside a grey card, which nobody can see; getting it wrong the other
 * way moves the whole page under the reader's thumb.
 */
const ROW = 78;
/** Full-bleed: the form keeps widening with the screen, and a wider form is a shorter one. */
const PAID_FLUID = { base: 1250, mid: 1130, sm: 1000, lg: 980 };
/** Capped at a column: the form is the same 408px wide from 480px up, so the height is the same too. */
const PAID_CARD = { base: 1230, mid: 1150, sm: 1150, lg: 1150 };
const FREE = { base: 460, mid: 460, sm: 460, lg: 460 };
const extra = Math.max(0, ticketTypes - 1) * ROW;
const reserve = collectsPayment ? (width === "card" ? PAID_CARD : PAID_FLUID) : FREE;
const vars = `--reserve-base:${reserve.base + extra}px;--reserve-mid:${reserve.mid + extra}px;--reserve-sm:${reserve.sm + extra}px;--reserve-lg:${reserve.lg + extra}px`;
---

{
  blocked ? (
    <p class="text-neutral-700">{t(locale, "events.ticketsUnavailable")}</p>
  ) : (
    <div
      id="tickets"
      class:list={[
        "min-h-0 scroll-mt-20 overflow-visible rounded-[2.5rem] border border-black/10 bg-neutral-50",
        className,
      ]}
      data-kintana-widget={`event:${eventId}`}
      data-kintana-locale={locale}
      data-kintana-demand={ownDemandLine ? "off" : undefined}
      aria-label={t(locale, "aria.ticketCheckout")}
    >
      {/* Holds the height the checkout will be, so the page does not jump when the iframe replaces it. */}
      <p class="checkout-reserve flex items-center justify-center px-8 text-center text-sm text-neutral-500" style={vars}>
        {t(locale, "tickets.loading")}
      </p>
    </div>
  )
}

<style>
  .checkout-reserve {
    min-height: var(--reserve-base);
  }
  @media (min-width: 480px) {
    .checkout-reserve {
      min-height: var(--reserve-mid);
    }
  }
  @media (min-width: 640px) {
    .checkout-reserve {
      min-height: var(--reserve-sm);
    }
  }
  @media (min-width: 1024px) {
    .checkout-reserve {
      min-height: var(--reserve-lg);
    }
  }
</style>
