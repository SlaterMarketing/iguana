---
import { t } from "../i18n/ui";
import type { Locale } from "../i18n/locale";

interface Props {
  eventId: string;
  locale?: Locale;
  blocked?: boolean;
  /** The host page is already showing "N people reserved recently", so the iframe must not say it again. */
  ownDemandLine?: boolean;
  /** Draw a copy of the checkout button that stays on screen while the real one is scrolled past. */
  stickyCta?: boolean;
  class?: string;
}

const { eventId, locale = "en", blocked = false, ownDemandLine = false, stickyCta = false, class: className } = Astro.props;
---

{
  blocked ? (
    <p class="text-neutral-700">{t(locale, "events.ticketsUnavailable")}</p>
  ) : (
    <div
      id="tickets"
      class:list={[
        "min-h-0 scroll-mt-20 overflow-visible rounded-[2.5rem] border border-black/10 bg-neutral-50",
        className,
      ]}
      data-kintana-widget={`event:${eventId}`}
      data-kintana-locale={locale}
      data-kintana-demand={ownDemandLine ? "off" : undefined}
      data-kintana-sticky-cta={stickyCta ? "on" : undefined}
      aria-label={t(locale, "aria.ticketCheckout")}
    >
      <p class="px-8 py-10 text-center text-sm text-neutral-500">{t(locale, "tickets.loading")}</p>
    </div>
  )
}
