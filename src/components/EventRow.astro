---
import type { KintanaPublicEvent } from "@kintana/sdk";
import { eventCitySlug, eventSupportsOnSiteCheckout, eventLanguageLabel, formatEventScheduleLine, formatMinorUnitsPrice } from "../lib/events";
import { t } from "../i18n/ui";
import { localizePath } from "../i18n/routes";
import type { Locale } from "../i18n/locale";

const { evt, highlightCity, featured = false, past = false, locale = "en" } = Astro.props as {
  evt: KintanaPublicEvent;
  highlightCity?: string;
  featured?: boolean;
  past?: boolean;
  locale?: Locale;
};

const detailHref = localizePath(locale, "eventDetail", { slug: evt.slug });
const onSiteCheckout = eventSupportsOnSiteCheckout(evt);
const ticketsHref =
  past || evt.status === "sold-out" || evt.status === "postponed"
    ? null
    : onSiteCheckout
      ? `${detailHref}#tickets`
      : evt.ticketUrl;

const posterMobileSrc = evt.imageUrlMobile?.trim() || evt.imageUrl;
const posterDesktopSrc = evt.imageUrl?.trim() || evt.imageUrlMobile?.trim();

const priceFormatted = formatMinorUnitsPrice(evt, locale);
const priceLabel = priceFormatted ? t(locale, "events.priceStarting").replace("{price}", priceFormatted) : null;
const languageLabel = eventLanguageLabel(evt, locale);

const statusBadge =
  past
    ? null
    : evt.status === "sold-out"
      ? t(locale, "ui.soldOut")
      : evt.status === "postponed"
        ? t(locale, "ui.postponed")
        : null;

const meta = evt.venue?.name
  ? evt.venue.name
  : [evt.city, evt.country].filter(Boolean).join(", ") || (locale === "es" ? "Lugar confirmado pronto" : "Venue confirmed soon");

const emphasized =
  Boolean(highlightCity?.trim()) && eventCitySlug(evt) === highlightCity;
---

<section aria-label={`${evt.name} — ticketing`}>
  <div
    class:list={[
      "overflow-hidden rounded-[1.85rem] border border-black/10 lg:grid lg:rounded-[2.75rem]",
      featured ? "lg:grid-cols-[minmax(280px,34%)_1fr] lg:min-h-[22rem]" : "lg:grid-cols-[42%_1fr]",
    ]}
  >
    <div
      class:list={[
        "bg-neutral-200 lg:aspect-auto",
        featured ? "aspect-[16/10] lg:min-h-[22rem]" : "aspect-[4/5] lg:min-h-[20rem]",
      ]}
    >
      {
        posterMobileSrc ? (
          <>
            <img
              class="size-full object-cover md:hidden"
              src={posterMobileSrc}
              alt=""
              loading="lazy"
              decoding="async"
            />
            <img
              class="hidden size-full object-cover md:block"
              src={posterDesktopSrc ?? posterMobileSrc}
              alt=""
              loading="lazy"
              decoding="async"
            />
          </>
        ) : (
          <div class="flex size-full items-center justify-center bg-neutral-950 text-neutral-500">{t(locale, "ui.loading")}</div>
        )
      }
    </div>

    <div
      class:list={[
        "flex flex-col justify-between px-8 py-10 lg:px-14 lg:py-16",
        past
          ? "bg-neutral-100 text-neutral-950"
          : emphasized
            ? "bg-brand/15 text-neutral-950"
            : "bg-brand text-white",
      ]}
    >
      <div class="space-y-6">
        <p class="text-[0.68rem] font-semibold uppercase tracking-[0.45em] opacity-85">
          {formatEventScheduleLine(evt, locale)}
        </p>

        {
          statusBadge ? (
            <p
              class:list={[
                "text-[0.65rem] font-semibold uppercase tracking-[0.38em]",
                emphasized ? "text-neutral-800 opacity-95" : "text-white opacity-95",
              ]}
            >
              {statusBadge}
            </p>
          ) : null
        }

        <h3
          class="font-semibold tracking-tight"
          style="font-family: var(--font-display); font-size: clamp(2.1rem, 3vw + 1.4rem, 3rem); line-height: 1.06;"
        >
          <a href={detailHref} class="transition-opacity hover:opacity-90">{evt.name}</a>
        </h3>

        {
          evt.headliner ? (
            <p class="text-sm font-semibold uppercase tracking-[0.38em] opacity-85">
              {t(locale, "ui.spotlight")} · {evt.headliner.name}
            </p>
          ) : null
        }

        <p class="text-base leading-relaxed opacity-[0.93]">{meta}</p>
        <p class="text-xs font-semibold uppercase tracking-[0.35em] opacity-85">
          {t(locale, "events.offeredIn").replace("{language}", languageLabel)}
        </p>
        {priceLabel ? <p class="text-sm font-medium opacity-[0.9]">{priceLabel}</p> : null}
      </div>

      <div class="mt-12 flex flex-wrap gap-6">
        {
          past ? (
            <a
              href={detailHref}
              class="inline-flex rounded-[2rem] border border-neutral-300 bg-white px-10 py-[0.9rem] text-[0.65rem] font-semibold uppercase tracking-[0.35em] text-neutral-950"
            >
              {t(locale, "ui.viewShow")}
            </a>
          ) : ticketsHref ? (
            <a
              href={ticketsHref}
              class:list={[
                "inline-flex rounded-[2rem] border px-10 py-[0.9rem] text-[0.65rem] font-semibold uppercase text-white",
                emphasized ? "border-neutral-950 bg-neutral-950 tracking-[0.39em]" : "border-transparent bg-neutral-950 tracking-[0.35em]",
              ]}
            >
              {t(locale, "ui.buyTickets")}
            </a>
          ) : (
            <a
              href={detailHref}
              class:list={[
                "inline-flex rounded-[2rem] border px-10 py-[0.9rem] text-[0.65rem] font-semibold uppercase tracking-[0.35em]",
                emphasized
                  ? "border-neutral-400 bg-white text-neutral-950"
                  : "border-white/40 bg-white/10 text-white backdrop-blur-sm",
              ]}
            >
              {t(locale, "ui.viewShow")}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>
