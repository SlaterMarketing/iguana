---
/**
 * The open mic landing page, and the destination every open mic ad points at.
 *
 * It exists because an ad URL has to outlive the show it sells. Event pages are dated (`/events/playa-del-carmen-
 * 2026-09-22/`), so a weekly campaign aimed at one would need its link rewritten every Tuesday, and would keep
 * spending on a dead page in the week nobody remembered. This page asks the API for the next bookable night in
 * each language every time it is rendered, so the same URL is always current.
 *
 * It also carries the checkout itself rather than linking on to it. Every hop between the ad and the card form
 * loses people, and at these prices the campaign cannot afford the leak.
 */
import type { KintanaPublicEvent } from "@kintana/sdk";

import Base from "../layouts/Base.astro";
import EventCheckoutWidget from "./EventCheckoutWidget.astro";
import NewsletterSignup from "./NewsletterSignup.astro";
import { site } from "../content/site";
import { formatEventDate } from "../lib/events";
import { loadEventsForCalendarPages } from "../lib/events-catalog";
import { holidayNotice } from "../lib/holiday-notice";
import { createLocalizedKintanaClient, getKintanaEnv } from "../lib/kintana-env";
import { logKintanaError, logKintanaSuccess } from "../lib/kintana-error";
import { bookableOpenMics, formatSeatPrice } from "../lib/open-mics";
import type { Locale } from "../i18n/locale";
import { localizePath } from "../i18n/routes";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { hasCredentials } = getKintanaEnv();

let upcoming: KintanaPublicEvent[] = [];
if (hasCredentials) {
  try {
    const loaded = await loadEventsForCalendarPages(createLocalizedKintanaClient(locale));
    upcoming = loaded.upcoming;
    logKintanaSuccess("listEvents /open-mic", upcoming.length);
  } catch (err) {
    logKintanaError("listEvents /open-mic", err);
  }
}

const bookable = bookableOpenMics(upcoming);
const next = { es: bookable.es[0], en: bookable.en[0] };
// How many later dates to offer under each night's checkout. Enough to catch somebody who is busy this week
// without turning the page into a calendar; there are always around fifteen on sale per language.
const LATER_NIGHTS = 4;
const notice = holidayNotice(locale);

const copy = {
  en: {
    kicker: "Every Tuesday and Wednesday",
    headline: "Open mic nights in Playa del Carmen",
    lede: "Free stand-up every week at Iguana Comedy. Come and watch, or sign up at the door and do five minutes yourself.",
    entry: "Free entry",
    seatTitle: "Reserve a seat",
    seatBody:
      "The room holds 80 and the open mics fill up. Entry is always free, but without a reservation we may have to turn you away once we are full. A reservation guarantees your seat and includes a free drink.",
    nights: [
      { key: "es" as const, day: "Tuesday", show: "Open mic in Spanish", detail: "Sign-up list 8:00 pm · Show 9:00 pm", event: next.es, later: bookable.es.slice(1, 1 + LATER_NIGHTS) },
      { key: "en" as const, day: "Wednesday", show: "Open mic in English", detail: "Doors 8:00 pm · Show 8:30 pm", event: next.en, later: bookable.en.slice(1, 1 + LATER_NIGHTS) },
    ],
    nextNight: "Next",
    perSeat: "per seat, includes a free drink",
    soon: "Dates for this night go up shortly. Check the calendar for what else is on.",
    cannotMakeIt: "Cannot make that one? Book a later night:",
    keepMeTitle: "Not this week?",
    keepMeBody: "We send one email on Monday morning with everything on that week. Nothing else, and you can stop it in one click.",
    allEvents: "See every show",
    performTitle: "Want to perform?",
    performBody:
      "Sign up at the door when you arrive. Five minutes, any style, first time or hundredth. No booking needed, and nothing to pay.",
    performLink: "Perform with us",
    findTitle: "Where to find us",
    maps: "Directions",
  },
  es: {
    kicker: "Cada martes y miércoles",
    headline: "Noches de open mic en Playa del Carmen",
    lede: "Stand-up gratis cada semana en Iguana Comedy. Ven a ver, o anótate en la puerta y haz cinco minutos tú.",
    entry: "Entrada gratis",
    seatTitle: "Reserva tu lugar",
    seatBody:
      "La sala es de 80 lugares y los open mics se llenan. La entrada siempre es gratis, pero sin reservación podemos negarte el paso si se llena. Tu reservación te garantiza un lugar e incluye una bebida gratis.",
    nights: [
      { key: "es" as const, day: "Martes", show: "Open mic en español", detail: "Lista 8:00 pm · Show 9:00 pm", event: next.es, later: bookable.es.slice(1, 1 + LATER_NIGHTS) },
      { key: "en" as const, day: "Miércoles", show: "Open mic en inglés", detail: "Puertas 8:00 pm · Show 8:30 pm", event: next.en, later: bookable.en.slice(1, 1 + LATER_NIGHTS) },
    ],
    nextNight: "Próximo",
    perSeat: "por lugar, incluye una bebida gratis",
    soon: "Las fechas de esta noche se publican en breve. Mira el calendario para ver qué más hay.",
    cannotMakeIt: "¿No puedes esa noche? Reserva una más adelante:",
    keepMeTitle: "¿Esta semana no?",
    keepMeBody: "Mandamos un correo el lunes por la mañana con todo lo que hay esa semana. Nada más, y lo cancelas con un clic.",
    allEvents: "Ver toda la cartelera",
    performTitle: "¿Quieres presentarte?",
    performBody:
      "Anótate en la puerta al llegar. Cinco minutos, el estilo que quieras, sea tu primera vez o la número cien. No hace falta reservar ni pagar nada.",
    performLink: "Actúa con nosotros",
    findTitle: "Dónde encontrarnos",
    maps: "Cómo llegar",
  },
}[locale];

// ViewContent names the night the visitor can actually book now, so the pixel and the page agree.
const headlineEvent = copy.nights.find((night) => night.event)?.event;
const pixelContent = headlineEvent
  ? {
      id: headlineEvent.id,
      name: headlineEvent.name,
      ...(headlineEvent.priceFrom != null ? { value: headlineEvent.priceFrom / 100 } : {}),
      ...(headlineEvent.priceCurrency ? { currency: headlineEvent.priceCurrency } : {}),
    }
  : undefined;
---

<Base
  title={`${copy.headline} · Iguana Comedy`}
  description={copy.lede}
  narrow={false}
  pixelContent={pixelContent}
>
  <section class="bg-neutral-950 text-white">
    {
      notice && (
        <div class="space-y-1 bg-amber-400 px-6 py-5 text-center text-neutral-950">
          <p class="text-sm font-semibold uppercase tracking-[0.25em]">{notice.headline}</p>
          <p class="text-sm leading-relaxed">{notice.detail}</p>
        </div>
      )
    }
    {/* Deliberately short. An ad click is paying to reach the checkout, and every pixel of hero above it is a
        pixel the form is pushed down by; the lede and the reasons to reserve now sit under the two cards, where
        they answer a question somebody has already decided to ask. */}
    <div class="mx-auto max-w-page px-6 py-5 text-center">
      <h1 class="mx-auto max-w-3xl leading-none" style="font-family: var(--font-display); font-size: clamp(1.5rem, 1.8vw + 0.9rem, 2.1rem);">
        {copy.headline}
      </h1>
      <p class="mt-2 text-xs font-semibold uppercase tracking-[0.2em] text-brand">{copy.entry} · {copy.kicker}</p>
    </div>
  </section>

  <section class="mx-auto max-w-page px-6 pb-16 pt-6">
    <div class="grid gap-10 lg:grid-cols-2">
      {
        copy.nights.map((night) => (
          <div class="flex flex-col rounded-[2rem] border border-black/10 bg-white">
            {/* Three tight lines: which night, when it actually is, and what a seat costs. Anything more is
                pushing the form it introduces further down the screen. */}
            <div class="border-b border-black/10 px-6 py-4 text-center">
              <p class="text-base font-semibold">
                <span class="uppercase tracking-[0.2em] text-neutral-500">{night.day}</span>
                <span class="text-neutral-400"> · </span>
                {night.show}
              </p>
              {night.event ? (
                <p class="mt-1 text-sm font-semibold text-neutral-900">
                  {formatEventDate(night.event.date, locale)}
                  <span class="font-normal text-neutral-500"> · {night.detail}</span>
                </p>
              ) : (
                <p class="mt-1 text-sm text-neutral-600">{night.detail}</p>
              )}
              {night.event ? (
                <p class="mt-1 text-sm text-neutral-600">
                  {formatSeatPrice(night.event, locale)} {copy.perSeat}
                </p>
              ) : null}
            </div>
            {night.event ? (
              <EventCheckoutWidget
                eventId={night.event.id}
                locale={locale}
                class="!min-h-0 !rounded-none !rounded-b-[2rem] !border-0 !bg-white !px-4 !py-6 sm:!px-6"
              />
            ) : (
              <p class="px-8 py-10 text-center text-sm text-neutral-500">{copy.soon}</p>
            )}
            {night.later.length ? (
              <div class="border-t border-black/10 px-6 py-5 text-center sm:px-8">
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-neutral-500">{copy.cannotMakeIt}</p>
                <ul class="mt-3 flex flex-wrap justify-center gap-2">
                  {night.later.map((later) => (
                    <li>
                      <a
                        class="inline-flex rounded-full border border-black/15 px-4 py-1.5 text-sm text-neutral-700 transition hover:border-neutral-900 hover:text-neutral-900"
                        href={localizePath(locale, "eventDetail", { slug: later.slug })}
                      >
                        {formatEventDate(later.date, locale)}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ) : null}
          </div>
        ))
      }
    </div>

    <p class="mx-auto mt-10 max-w-2xl text-center text-sm leading-relaxed text-neutral-600">{copy.lede}</p>
    <p class="mx-auto mt-3 max-w-2xl text-center text-sm leading-relaxed text-neutral-600">{copy.seatBody}</p>

    <p class="mt-6 text-center">
      <a
        class="text-sm font-semibold uppercase tracking-[0.3em] text-neutral-900 underline-offset-4 hover:underline"
        href={localizePath(locale, "events")}
      >
        {copy.allEvents} →
      </a>
    </p>
  </section>

  {/* Somebody who will not book tonight is not necessarily lost: the weekly email goes out every Monday with
      whatever is on that week, so an address is worth more than a bounce. */}
  <section class="border-t border-black/10 bg-neutral-950 text-white">
    <div class="mx-auto max-w-2xl px-6 py-12 text-center">
      <h2 class="leading-none" style="font-family: var(--font-display); font-size: clamp(1.5rem, 1.5vw + 1rem, 2rem);">
        {copy.keepMeTitle}
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-white/70">{copy.keepMeBody}</p>
      <NewsletterSignup locale={locale} tone="dark" class="mx-auto mt-6 max-w-md" />
    </div>
  </section>

  <section class="border-t border-black/10 bg-neutral-50">
    <div class="mx-auto grid max-w-page gap-10 px-6 py-16 sm:grid-cols-2">
      <div>
        <h2 class="leading-none" style="font-family: var(--font-display); font-size: clamp(1.6rem, 1.5vw + 1rem, 2.1rem);">
          {copy.performTitle}
        </h2>
        <p class="mt-4 text-sm leading-relaxed text-neutral-600">{copy.performBody}</p>
        <a
          class="mt-5 inline-flex text-sm font-semibold uppercase tracking-[0.3em] text-neutral-900 underline-offset-4 hover:underline"
          href={localizePath(locale, "performWithUs")}
        >
          {copy.performLink} →
        </a>
      </div>
      <div>
        <h2 class="leading-none" style="font-family: var(--font-display); font-size: clamp(1.6rem, 1.5vw + 1rem, 2.1rem);">
          {copy.findTitle}
        </h2>
        <p class="mt-4 text-sm leading-relaxed text-neutral-600">{site.venueAddress}</p>
        <a
          class="mt-5 inline-flex text-sm font-semibold uppercase tracking-[0.3em] text-neutral-900 underline-offset-4 hover:underline"
          href={site.venueMapsUrl}
          rel="noopener"
          target="_blank"
        >
          {copy.maps} →
        </a>
      </div>
    </div>
  </section>
</Base>
