---
/**
 * The open mic landing page, and the destination every open mic ad points at.
 *
 * It exists because an ad URL has to outlive the show it sells. Event pages are dated (`/events/playa-del-carmen-
 * 2026-09-22/`), so a weekly campaign aimed at one would need its link rewritten every Tuesday, and would keep
 * spending on a dead page in the week nobody remembered. This page asks the API for the nights that are still
 * bookable every time it is rendered, so the same URL is always current.
 *
 * ONE night, ONE form. It used to show both nights side by side, which was wrong in two ways: a Spanish ad sent
 * somebody to a page half taken up by an English show they were never going to attend, and two checkouts meant
 * the page had to be read before it could be used. It now shows a single column with one checkout, defaulting to
 * the night that matches the page language, with a toggle for the other and the following dates one tap away.
 * `?night=` and `?date=` pin it, so an ad can land on exactly the night it sold.
 *
 * It carries the checkout itself rather than linking on to it. Every hop between the ad and the card form loses
 * people, and at these prices the campaign cannot afford the leak.
 */
import type { KintanaPublicEvent } from "@kintana/sdk";

import Base from "../layouts/Base.astro";
import EventCheckoutWidget from "./EventCheckoutWidget.astro";
import NewsletterSignup from "./NewsletterSignup.astro";
import { site } from "../content/site";
import { demandLine } from "../lib/demand";
import { eventVenueMapEmbedUrl } from "../lib/event-hero";
import { eventCollectsPayment, eventTicketTypeCount, formatEventDate, formatEventDateShort, formatEventTime } from "../lib/events";
import { loadEventsForCalendarPages } from "../lib/events-catalog";
import { holidayNotice } from "../lib/holiday-notice";
import { createLocalizedKintanaClient, getKintanaEnv } from "../lib/kintana-env";
import { logKintanaError, logKintanaSuccess } from "../lib/kintana-error";
import { bookableOpenMics, formatSeatPrice, isFreeToReserve } from "../lib/open-mics";
import type { Locale } from "../i18n/locale";
import { localizePath } from "../i18n/routes";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { hasCredentials } = getKintanaEnv();

let upcoming: KintanaPublicEvent[] = [];
if (hasCredentials) {
  try {
    const loaded = await loadEventsForCalendarPages(createLocalizedKintanaClient(locale));
    upcoming = loaded.upcoming;
    logKintanaSuccess("listEvents /open-mic", upcoming.length);
  } catch (err) {
    logKintanaError("listEvents /open-mic", err);
  }
}

const bookable = bookableOpenMics(upcoming);

// Which night. The default is the language of the page the visitor is on, because a Spanish speaker is not
// coming to the English night and the reverse is just as true; `?night=` lets an ad be explicit about it.
const askedNight = Astro.url.searchParams.get("night");
const nightKey: "es" | "en" = askedNight === "es" || askedNight === "en" ? askedNight : locale;
// Fall back to the other night rather than showing nothing, on a week where one of them has sold out.
const shownKey: "es" | "en" = bookable[nightKey].length ? nightKey : nightKey === "es" ? "en" : "es";
const nights = bookable[shownKey];

const DATES_SHOWN = 4;
const askedDate = Astro.url.searchParams.get("date");
const selected = nights.find((evt) => evt.date === askedDate) ?? nights[0];
const dateChoices = nights.slice(0, DATES_SHOWN);

/** Keeps the ad's click id on the URL when somebody switches night or date, so attribution survives a tap. */
const fbclid = Astro.url.searchParams.get("fbclid");
function href(night: "es" | "en", date?: string) {
  const params = new URLSearchParams({ night });
  if (date) params.set("date", date);
  if (fbclid) params.set("fbclid", fbclid);
  return `${localizePath(locale, "openMic")}?${params.toString()}`;
}

const notice = holidayNotice(locale);

const copy = {
  en: {
    kicker: "Free entry · Every Tuesday and Wednesday",
    headline: "Open mic nights in Playa del Carmen",
    lede: "Free stand-up every week at Iguana Comedy. Come and watch, or sign up at the door and do five minutes yourself.",
    seatBody:
      "The room holds 80 and the open mics fill up. Entry is always free, but without a reservation we may have to turn you away once we are full. Reserving is free too and holds your seat.",
    nights: {
      es: { show: "Open mic in Spanish", detail: "Sign-up list 8:00 pm · Show 9:00 pm", tab: "Tue · Spanish" },
      en: { show: "Open mic in English", detail: "Doors 8:00 pm · Show 9:00 pm", tab: "Wed · English" },
    },
    perSeat: "per seat, includes a free drink",
    freeToReserve: "Free to reserve",
    soon: "Dates go up shortly. Check the calendar for what else is on.",
    pickDate: "Which night?",
    allEvents: "See every show",
    performTitle: "Want to perform?",
    performBody:
      "Sign up at the door when you arrive. Five minutes, any style, first time or hundredth. No booking needed, and nothing to pay.",
    performLink: "Perform with us",
    findTitle: "Where to find us",
    maps: "Directions",
    keepMeTitle: "Not this week?",
    keepMeBody: "We send one email on Monday morning with everything on that week. Nothing else, and you can stop it in one click.",
  },
  es: {
    kicker: "Entrada gratis · Cada martes y miércoles",
    headline: "Noches de open mic en Playa del Carmen",
    lede: "Stand-up gratis cada semana en Iguana Comedy. Ven a ver, o anótate en la puerta y haz cinco minutos tú.",
    seatBody:
      "La sala es de 80 lugares y los open mics se llenan. La entrada siempre es gratis, pero sin reservación podemos negarte el paso si se llena. Reservar también es gratis y te aparta el lugar.",
    nights: {
      es: { show: "Open mic en español", detail: "Lista 8:00 pm · Show 9:00 pm", tab: "Mar · Español" },
      en: { show: "Open mic en inglés", detail: "Puertas 8:00 pm · Show 9:00 pm", tab: "Mié · Inglés" },
    },
    perSeat: "por lugar, incluye una bebida gratis",
    freeToReserve: "Reservar es gratis",
    soon: "Las fechas se publican en breve. Mira el calendario para ver qué más hay.",
    pickDate: "¿Qué noche?",
    allEvents: "Ver toda la cartelera",
    performTitle: "¿Quieres presentarte?",
    performBody:
      "Anótate en la puerta al llegar. Cinco minutos, el estilo que quieras, sea tu primera vez o la número cien. No hace falta reservar ni pagar nada.",
    performLink: "Actúa con nosotros",
    findTitle: "Dónde encontrarnos",
    maps: "Cómo llegar",
    keepMeTitle: "¿Esta semana no?",
    keepMeBody: "Mandamos un correo el lunes por la mañana con todo lo que hay esa semana. Nada más, y lo cancelas con un clic.",
  },
}[locale];

const night = copy.nights[shownKey];
// Somebody deciding whether to come out tonight wants to see WHERE, not read an address and take it on
// trust. The event pages have had the map all along; the page the ads actually pay for did not.
const mapEmbedUrl = selected ? eventVenueMapEmbedUrl(selected) : null;
// Rendered here rather than inside the checkout iframe, which is told to stop drawing its own copy.
const pressure = selected ? demandLine(selected, locale) : null;
/**
 * When the night actually is, taken from the night itself.
 *
 * This used to be a fixed line per series, so moving the English show from 8:30 to 9 meant remembering to
 * change a sentence in a copy table that has no idea what the API says. The fallback is still there for the
 * case the lander has no night to show.
 */
function nightDetail(event: KintanaPublicEvent | null, fallback: string, locale: Locale): string {
  if (!event) return fallback;
  const doors = formatEventTime(event.doorsOpen, locale);
  const show = formatEventTime(event.showTime, locale);
  if (!doors && !show) return fallback;
  const doorsLabel = locale === "es" ? "Puertas" : "Doors";
  const parts = [];
  if (doors) parts.push(`${doorsLabel} ${doors}`);
  if (show) parts.push(`Show ${show}`);
  return parts.join(" · ");
}

---

<Base title={`${copy.headline} · Iguana Comedy`} description={copy.lede} narrow={false} pixelContent={selected
  ? {
      id: selected.id,
      name: selected.name,
      ...(selected.priceFrom != null ? { value: selected.priceFrom / 100 } : {}),
      ...(selected.priceCurrency ? { currency: selected.priceCurrency } : {}),
    }
  : undefined}>
  <section class="bg-neutral-950 text-white">
    {
      notice && (
        <div class="space-y-1 bg-amber-400 px-6 py-4 text-center text-neutral-950">
          <p class="text-sm font-semibold uppercase tracking-[0.25em]">{notice.headline}</p>
          <p class="text-sm leading-relaxed">{notice.detail}</p>
        </div>
      )
    }
    {/* One band, two lines. Everything that used to live here (the lede, the reasons to reserve) is below the
        checkout now: an ad click is paying to reach a form, and every pixel above it is a pixel the form moves
        down by. */}
    <div class="mx-auto max-w-page px-6 py-2.5 text-center sm:py-4">
      <h1
        class="mx-auto max-w-2xl leading-none"
        style="font-family: var(--font-display); font-size: clamp(1.35rem, 1.5vw + 0.85rem, 1.9rem);"
      >
        {copy.headline}
      </h1>
      <p class="mt-1.5 text-[0.7rem] font-semibold uppercase tracking-[0.2em] text-brand">{copy.kicker}</p>
    </div>
  </section>

  {/* One column, one form. Two checkouts side by side made the visitor choose before they could act, and gave
      half the page to a night in a language they do not speak. */}
  <section class="mx-auto max-w-xl px-4 pb-14 pt-3 sm:px-6 sm:pt-4">
    <div class="overflow-hidden rounded-[1.75rem] border border-black/10 bg-white">
      <div class="grid grid-cols-2 border-b border-black/10">
        {
          (["es", "en"] as const).map((key) => (
            <a
              class:list={[
                "px-3 py-3 text-center text-sm font-semibold transition",
                key === shownKey ? "bg-neutral-950 text-white" : "bg-white text-neutral-500 hover:text-neutral-900",
              ]}
              href={href(key)}
              aria-current={key === shownKey ? "true" : undefined}
            >
              {copy.nights[key].tab}
            </a>
          ))
        }
      </div>

      {/* The tab already names the night, so this says only what the tab cannot: when it is, and what it costs.
          Every line here pushes the card form further from the ad click that paid for it. */}
      <div class="border-b border-black/10 px-5 py-2 text-center sm:py-3">
        <p class="text-sm text-neutral-600">
          <span class="font-semibold text-neutral-900">{selected ? formatEventDate(selected.date, locale) : night.show}</span>
          <span> · {nightDetail(selected, night.detail, locale)}</span>
        </p>
        {
          selected ? (
            <p class="mt-0.5 text-sm text-neutral-600">
              {isFreeToReserve(selected) ? (
                <span class="font-semibold text-brand">{copy.freeToReserve}</span>
              ) : (
                <>
                  <span class="font-semibold text-neutral-900">{formatSeatPrice(selected, locale)}</span> {copy.perSeat}
                </>
              )}
            </p>
          ) : null
        }
        {/* Somebody else is already coming. It belongs beside the date it is about, where the eye already is,
            rather than below the night pills where it read as a note on the pills. */}
        {
          pressure ? (
            <p class:list={["mt-1.5 text-sm font-semibold", pressure.tight ? "text-red-700" : "text-brand"]}>
              {pressure.text}
            </p>
          ) : null
        }
      </div>

      {
        dateChoices.length > 1 ? (
          <div class="border-b border-black/10 px-4 py-1.5 sm:py-2.5">
            <p class="text-center text-[0.6rem] font-semibold uppercase tracking-[0.2em] text-neutral-500">
              {copy.pickDate}
            </p>
            {/* One row that scrolls, never two that wrap: a second row of pills costs the reserve button
                forty-odd pixels of fold, and the page exists for that button. */}
            <ul class="mt-1.5 flex snap-x snap-mandatory justify-start gap-1.5 overflow-x-auto pb-0.5 sm:justify-center [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
              {dateChoices.map((evt) => (
                <li class="shrink-0 snap-start">
                  <a
                    class:list={[
                      "inline-flex whitespace-nowrap rounded-full border px-3 py-1.5 text-sm transition",
                      evt.id === selected?.id
                        ? "border-neutral-900 bg-neutral-900 text-white"
                        : "border-black/15 text-neutral-700 hover:border-neutral-900 hover:text-neutral-900",
                    ]}
                    href={href(shownKey, evt.date)}
                    aria-current={evt.id === selected?.id ? "true" : undefined}
                  >
                    {formatEventDateShort(evt.date, locale)}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ) : null
      }

      {
        selected ? (
          <EventCheckoutWidget
            eventId={selected.id}
            locale={locale}
            ownDemandLine
            collectsPayment={eventCollectsPayment(selected)}
            ticketTypes={eventTicketTypeCount(selected)}
            class="!min-h-0 !rounded-none !border-0 !bg-white !px-4 !py-5 sm:!px-6"
          />
        ) : (
          <p class="px-8 py-10 text-center text-sm text-neutral-500">{copy.soon}</p>
        )
      }
    </div>

    <p class="mx-auto mt-8 max-w-xl text-center text-sm leading-relaxed text-neutral-600">{copy.lede}</p>
    <p class="mx-auto mt-3 max-w-xl text-center text-sm leading-relaxed text-neutral-600">{copy.seatBody}</p>

    <p class="mt-6 text-center">
      <a
        class="text-sm font-semibold uppercase tracking-[0.3em] text-neutral-900 underline-offset-4 hover:underline"
        href={localizePath(locale, "events")}
      >
        {copy.allEvents} →
      </a>
    </p>
  </section>

  {/* Somebody who will not book tonight is not necessarily lost: the weekly email goes out every Monday with
      whatever is on that week, so an address is worth more than a bounce. */}
  <section class="border-t border-black/10 bg-neutral-950 text-white">
    <div class="mx-auto max-w-xl px-6 py-10 text-center">
      <h2 class="leading-none" style="font-family: var(--font-display); font-size: clamp(1.4rem, 1.4vw + 0.9rem, 1.9rem);">
        {copy.keepMeTitle}
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-white/70">{copy.keepMeBody}</p>
      <NewsletterSignup locale={locale} tone="dark" class="mx-auto mt-5 max-w-md" />
    </div>
  </section>

  <section class="border-t border-black/10 bg-neutral-50">
    <div class="mx-auto grid max-w-page gap-10 px-6 py-14 sm:grid-cols-2">
      <div>
        <h2 class="leading-none" style="font-family: var(--font-display); font-size: clamp(1.5rem, 1.4vw + 1rem, 2rem);">
          {copy.performTitle}
        </h2>
        <p class="mt-4 text-sm leading-relaxed text-neutral-600">{copy.performBody}</p>
        <a
          class="mt-5 inline-flex text-sm font-semibold uppercase tracking-[0.3em] text-neutral-900 underline-offset-4 hover:underline"
          href={localizePath(locale, "performWithUs")}
        >
          {copy.performLink} →
        </a>
      </div>
      <div>
        <h2 class="leading-none" style="font-family: var(--font-display); font-size: clamp(1.5rem, 1.4vw + 1rem, 2rem);">
          {copy.findTitle}
        </h2>
        <p class="mt-4 text-sm leading-relaxed text-neutral-600">{site.venueAddress}</p>
        {
          mapEmbedUrl ? (
            <div class="mt-4 overflow-hidden rounded-2xl border border-black/10">
              <iframe
                title={copy.findTitle}
                src={mapEmbedUrl}
                width="100%"
                height="240"
                style="border: 0;"
                allowfullscreen
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                class="block w-full"
              />
            </div>
          ) : null
        }
        <a
          class="mt-5 inline-flex text-sm font-semibold uppercase tracking-[0.3em] text-neutral-900 underline-offset-4 hover:underline"
          href={site.venueMapsUrl}
          rel="noopener"
          target="_blank"
        >
          {copy.maps} →
        </a>
      </div>
    </div>
  </section>
</Base>
