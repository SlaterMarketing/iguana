---
import { mergeBrand } from "../lib/merge-brand";
import type { MergedSite } from "../lib/merge-brand";
import { t } from "../i18n/ui";
import { localizePath, getAlternatePath } from "../i18n/routes";
import type { Locale } from "../i18n/locale";
import {
  LOCALE_PREFERENCE_COOKIE,
  LOCALE_PREFERENCE_MAX_AGE_SECONDS,
} from "../lib/locale-preference";
import LocaleFlagDropdown from "./LocaleFlagDropdown.astro";

interface Props {
  pathname?: string;
  transparent?: boolean;
  locale: Locale;
  /** Merged fallback + Kintana listFiles URLs — pass from layout */
  brand?: MergedSite;
}

const { pathname: pathnameProp, transparent = false, locale, brand: brandProp } = Astro.props;
const brand = brandProp ?? mergeBrand(Astro.locals.brandOverrides ?? {});
const pathnameRaw = pathnameProp ?? Astro.url.pathname;

function matches(href: string) {
  const p = pathnameRaw.replace(/\/$/, "") || "/";
  const h = href.replace(/\/$/, "") || "/";
  return p === h;
}

const links: { key: "events" | "locations" | "comedians" | "store" | "contact"; external?: boolean }[] = [
  { key: "events" },
  { key: "locations" },
  { key: "comedians" },
  { key: "store" },
  { key: "contact" },
];

const enPath =
  locale === "en" ? pathnameRaw : getAlternatePath("es", pathnameRaw) ?? localizePath("en", "home");
const esPath =
  locale === "es" ? pathnameRaw : getAlternatePath("en", pathnameRaw) ?? localizePath("es", "home");
---

<header
  data-site-header=""
  data-transparent-bg={transparent ? "1" : "0"}
  class:list={[
    "site-header top-0 z-40 w-full transition-[padding] duration-300 ease-out",
    transparent ? "fixed pointer-events-none" : "sticky",
  ]}
>
  <div
    data-header-track=""
    class:list={[
      "header-track mx-auto flex w-full max-w-[110rem] items-center justify-between gap-3 px-4 py-4 transition-all duration-300 ease-out sm:px-8 sm:py-5",
      transparent ? "pointer-events-auto" : "border-b border-black/10 bg-white/95 backdrop-blur-md",
    ]}
  >
    <div
      data-header-nav-cluster=""
      class="header-nav-cluster flex min-w-0 flex-1 items-center justify-between gap-3 rounded-full bg-white px-4 py-2.5 shadow-[0_8px_32px_rgba(0,0,0,0.12)] transition-all duration-300 ease-out sm:gap-x-8 sm:px-8 sm:py-3 md:flex-initial md:justify-start"
    >
      <a href={localizePath(locale, "home")} class="shrink-0">
        <img
          src={brand.heroLogoUrl}
          alt={t(locale, "seo.siteName")}
          class="h-5 w-auto sm:h-6"
          width="160"
          height="28"
          decoding="async"
        />
      </a>

      <nav
        class="hidden flex-wrap items-center gap-x-2 gap-y-1 text-[0.62rem] font-semibold uppercase tracking-[0.2em] text-neutral-500 md:flex sm:text-[0.65rem] sm:tracking-[0.24em]"
        aria-label={t(locale, "nav.aria.primary")}
      >
        {
          links.map((link, index) => {
            const href = localizePath(locale, link.key);
            const active = !link.external && matches(href);
            return (
              <>
                {index > 0 ? <span class="text-neutral-400/90" aria-hidden="true">/</span> : null}
                <a
                  href={href}
                  class:list={[
                    active ? "text-neutral-950" : "hover:text-neutral-800",
                    link.external ? "inline-flex items-center gap-1" : "",
                  ]}
                  {...(link.external ? { target: "_blank", rel: "noreferrer noopener" } : {})}
                >
                  {t(locale, `nav.${link.key === "locations" ? "cities" : link.key === "store" ? "merch" : link.key}`)}
                </a>
              </>
            );
          })
        }
      </nav>

      <div class="flex items-center gap-1">
        <LocaleFlagDropdown locale={locale} enPath={enPath} esPath={esPath} compact />

        <button
          type="button"
          class="mobile-menu-toggle inline-flex size-10 shrink-0 items-center justify-center rounded-full text-neutral-950 transition-colors hover:bg-neutral-100 md:hidden"
          aria-expanded="false"
          aria-controls="site-mobile-menu"
          data-mobile-menu-toggle=""
        >
          <span class="sr-only">{t(locale, "nav.openMenu")}</span>
          <svg class="mobile-menu-icon-open size-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16" />
          </svg>
          <svg class="mobile-menu-icon-close absolute size-5 opacity-0" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="M6 6l12 12M18 6 6 18" />
          </svg>
        </button>
      </div>
    </div>

    <div class="flex shrink-0 items-center gap-2 sm:gap-3">
      <a
        href={localizePath(locale, "events")}
        data-header-cta=""
        class="header-cta btn-pill hidden items-center gap-2 rounded-full bg-white px-6 py-2.5 text-[0.62rem] font-bold uppercase tracking-[0.22em] text-neutral-950 shadow-[0_8px_32px_rgba(0,0,0,0.12)] transition-all duration-300 ease-out sm:inline-flex sm:px-8 sm:py-3 sm:text-[0.65rem] sm:tracking-[0.26em]"
        aria-label={t(locale, "nav.cta")}
      >
        {t(locale, "nav.cta")}
        <svg class="btn-pill-arrow h-[0.65rem] w-[1.1rem] shrink-0 text-brand transition-colors" viewBox="0 0 22 14" aria-hidden="true">
          <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="m2 7h18m-6-6 6 6-6 6" />
        </svg>
      </a>
    </div>
  </div>

  <div
    id="site-mobile-menu"
    data-mobile-menu=""
    class="mobile-menu-panel pointer-events-none fixed inset-0 z-50 md:hidden"
    aria-hidden="true"
    inert
  >
    <button
      type="button"
      class="mobile-menu-backdrop absolute inset-0 bg-black/50 opacity-0 transition-opacity duration-300"
      tabindex="-1"
      aria-label={t(locale, "nav.closeMenu")}
      data-mobile-menu-close=""
    />

    <div
      class="mobile-menu-sheet absolute right-0 top-0 flex h-full w-[min(100%,20rem)] translate-x-full flex-col bg-white px-6 pb-10 pt-6 shadow-[-12px_0_40px_rgba(0,0,0,0.12)] transition-transform duration-300 ease-out"
    >
      <div class="flex items-center justify-between gap-4 border-b border-black/10 pb-5">
        <a href={localizePath(locale, "home")} class="shrink-0" data-mobile-menu-close="">
          <img src={brand.heroLogoUrl} alt={t(locale, "seo.siteName")} class="h-5 w-auto" width="160" height="28" decoding="async" />
        </a>
        <button
          type="button"
          class="inline-flex size-10 items-center justify-center rounded-full text-neutral-950 transition-colors hover:bg-neutral-100"
          aria-label={t(locale, "nav.closeMenu")}
          data-mobile-menu-close=""
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="M6 6l12 12M18 6 6 18" />
          </svg>
        </button>
      </div>

      <nav class="mt-8 flex flex-1 flex-col gap-1" aria-label={t(locale, "nav.aria.mobile")}>
        {
          links.map((link) => {
            const href = localizePath(locale, link.key);
            const active = !link.external && matches(href);
            return (
              <a
                href={href}
                class:list={[
                  "rounded-2xl px-4 py-3.5 text-lg font-semibold tracking-tight transition-colors",
                  active ? "bg-brand/10 text-neutral-950" : "text-neutral-700 hover:bg-neutral-50 hover:text-neutral-950",
                ]}
                style={active ? "font-family: var(--font-display); letter-spacing: 0.04em;" : ""}
                {...(link.external ? { target: "_blank", rel: "noreferrer noopener" } : {})}
                data-mobile-menu-close=""
              >
                {t(locale, `nav.${link.key === "locations" ? "cities" : link.key === "store" ? "merch" : link.key}`)}
              </a>
            );
          })
        }
      </nav>

      <div class="mt-6 border-t border-black/10 pt-5">
        <LocaleFlagDropdown locale={locale} enPath={enPath} esPath={esPath} closeMobileMenu />
      </div>

      <a
        href={localizePath(locale, "events")}
        class="btn-pill mt-6 inline-flex items-center justify-center gap-2 rounded-full bg-neutral-950 px-6 py-3.5 text-[0.65rem] font-bold uppercase tracking-[0.26em] text-white"
        data-mobile-menu-close=""
      >
        {t(locale, "nav.cta")}
        <svg class="h-[0.65rem] w-[1.1rem] shrink-0" viewBox="0 0 22 14" aria-hidden="true">
          <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="m2 7h18m-6-6 6 6-6 6" />
        </svg>
      </a>
    </div>
  </div>
</header>

<script
  define:vars={{
    localeCookieName: LOCALE_PREFERENCE_COOKIE,
    localeCookieMaxAge: LOCALE_PREFERENCE_MAX_AGE_SECONDS,
  }}
>
  function initLocalePreferenceOnSwitch() {
    document.querySelectorAll("a[data-locale-preference]").forEach((el) => {
      if (!(el instanceof HTMLAnchorElement)) return;
      if (el.dataset.localePreferenceBound === "1") return;
      el.dataset.localePreferenceBound = "1";
      el.addEventListener("click", () => {
        const loc = el.dataset.localePreference;
        if (loc !== "en" && loc !== "es") return;
        const secure = typeof location !== "undefined" && location.protocol === "https:" ? "; Secure" : "";
        document.cookie = `${localeCookieName}=${loc}; Path=/; Max-Age=${String(localeCookieMaxAge)}; SameSite=Lax${secure}`;
      });
    });
  }

  function initSiteHeaderScroll() {
    const header = document.querySelector("[data-site-header]");
    if (!(header instanceof HTMLElement) || header.dataset.headerScrollReady === "1") return;
    header.dataset.headerScrollReady = "1";

    const threshold = 56;
    const desktopNav = window.matchMedia("(min-width: 768px)");

    function update() {
      const scrolled = window.scrollY > threshold;
      header.toggleAttribute("data-scrolled", desktopNav.matches && scrolled);
    }

    update();
    desktopNav.addEventListener("change", update);
    window.addEventListener("scroll", update, { passive: true });
    document.addEventListener("astro:page-load", update);
  }

  function initMobileMenu() {
    const header = document.querySelector("[data-site-header]");
    const panel = document.querySelector("[data-mobile-menu]");
    const toggle = document.querySelector("[data-mobile-menu-toggle]");
    if (!(header instanceof HTMLElement) || !(panel instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement)) {
      return;
    }
    if (panel.dataset.mobileMenuReady === "1") return;
    panel.dataset.mobileMenuReady = "1";

    const sheet = panel.querySelector(".mobile-menu-sheet");
    const backdrop = panel.querySelector(".mobile-menu-backdrop");
    const closeTargets = panel.querySelectorAll("[data-mobile-menu-close]");

    function setOpen(open: boolean) {
      header.toggleAttribute("data-mobile-menu-open", open);
      panel.toggleAttribute("data-open", open);
      panel.classList.toggle("pointer-events-none", !open);
      panel.classList.toggle("pointer-events-auto", open);
      panel.setAttribute("aria-hidden", open ? "false" : "true");
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      toggle.querySelector(".sr-only")!.textContent = open ? "Close menu" : "Open menu";

      if (open) {
        panel.removeAttribute("inert");
        document.body.classList.add("overflow-hidden");
      } else {
        panel.setAttribute("inert", "");
        document.body.classList.remove("overflow-hidden");
      }

      if (sheet instanceof HTMLElement) {
        sheet.classList.toggle("translate-x-0", open);
        sheet.classList.toggle("translate-x-full", !open);
      }
      if (backdrop instanceof HTMLElement) {
        backdrop.classList.toggle("opacity-100", open);
        backdrop.classList.toggle("opacity-0", !open);
      }
    }

    function closeMenu() {
      setOpen(false);
    }

    toggle.addEventListener("click", () => {
      setOpen(!header.hasAttribute("data-mobile-menu-open"));
    });

    closeTargets.forEach((el) => {
      el.addEventListener("click", closeMenu);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && header.hasAttribute("data-mobile-menu-open")) {
        closeMenu();
      }
    });

    window.matchMedia("(min-width: 768px)").addEventListener("change", (event) => {
      if (event.matches) closeMenu();
    });

    document.addEventListener("astro:page-load", closeMenu);
  }

  initSiteHeaderScroll();
  initMobileMenu();
  initLocalePreferenceOnSwitch();
  document.addEventListener("astro:page-load", () => {
    initSiteHeaderScroll();
    initMobileMenu();
    initLocalePreferenceOnSwitch();
  });
</script>

<style>
  @media (min-width: 768px) {
    .site-header[data-scrolled] {
      padding-top: 0.65rem;
      pointer-events: auto;
    }

    .site-header[data-scrolled] .header-track {
      width: 80vw;
      max-width: 72rem;
      flex-wrap: nowrap;
      gap: 1rem;
      border: 1px solid #000;
      border-radius: 9999px;
      background-color: #fff;
      padding: 0.45rem 0.55rem 0.45rem 1.25rem;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    }

    .site-header[data-transparent-bg="1"][data-scrolled] .header-track {
      border-bottom: 1px solid #000;
      backdrop-filter: none;
    }

    .site-header[data-scrolled] .header-nav-cluster {
      background: transparent;
      box-shadow: none;
      padding: 0.35rem 0;
    }

    .site-header[data-scrolled] .header-cta {
      background-color: #121715;
      color: #fff;
      box-shadow: none;
    }

    .site-header[data-scrolled] .header-cta .btn-pill-arrow {
      color: #fff;
    }

    .site-header[data-scrolled] .header-cta.btn-pill:hover {
      background-color: var(--color-brand-hover);
      color: #fff;
    }
  }

  .site-header[data-mobile-menu-open] .mobile-menu-toggle {
    position: relative;
  }

  .site-header[data-mobile-menu-open] .mobile-menu-icon-open {
    opacity: 0;
  }

  .site-header[data-mobile-menu-open] .mobile-menu-icon-close {
    opacity: 1;
  }

  /* Drive mobile menu visibility from [data-open] so it works regardless of
     whether Tailwind's scanner picks up the dynamically-toggled class names. */
  [data-mobile-menu][data-open] {
    pointer-events: auto;
  }

  [data-mobile-menu][data-open] .mobile-menu-backdrop {
    opacity: 1;
  }

  [data-mobile-menu][data-open] .mobile-menu-sheet {
    transform: translateX(0);
  }
</style>
