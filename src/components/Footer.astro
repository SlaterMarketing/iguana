---
import { site } from "../content/site";
import { t } from "../i18n/ui";
import { localizePath } from "../i18n/routes";
import type { Locale } from "../i18n/locale";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<footer class="border-t border-black/10 bg-ink pb-24 pt-28 text-neutral-300">
  <div class="mx-auto grid max-w-6xl gap-14 px-4 sm:gap-24 md:grid-cols-[1.05fr_repeat(4,minmax(0,1fr))] sm:px-6 lg:gap-28">
    <div class="space-y-12">
      <p class="text-4xl text-white lg:text-[2.75rem]" style="font-family: var(--font-display);">{site.name}</p>
      <div class="space-y-8 text-neutral-400">
        <p class="text-lg text-white">{site.email}</p>
        <div class="text-lg tracking-wide text-neutral-400">
          <p class="text-white">{site.whatsappDisplay}</p>
          <p class="text-sm uppercase tracking-[0.45em] text-neutral-400">{t(locale, "footer.whatsappLabel")}</p>
          <p class="text-sm lowercase text-neutral-500">{t(locale, "footer.whatsappSub")}</p>
        </div>
      </div>
    </div>
    <div>
      <p class="pb-10 text-[0.65rem] font-semibold uppercase tracking-[0.45em] text-neutral-600">{t(locale, "footer.navigate")}</p>
      <nav class="space-y-4 text-neutral-400">
        <a class="block hover:text-brand" href={localizePath(locale, "events")}>{t(locale, "footer.shows")}</a>
        <a class="block hover:text-brand" href={localizePath(locale, "locations")}>{t(locale, "footer.locations")}</a>
        <a class="block hover:text-brand" href={localizePath(locale, "comedians")}>{t(locale, "footer.wallOfComedians")}</a>
        <a class="block hover:text-brand" href={localizePath(locale, "workWithUs")}>{t(locale, "footer.workWithUs")}</a>
        <a class="block hover:text-brand" href={localizePath(locale, "hotelsAndResorts")}>{t(locale, "footer.hotelsAndResorts")}</a>
        <a class="block hover:text-brand" href={localizePath(locale, "performWithUs")}>{t(locale, "footer.performWithUs")}</a>
      </nav>
    </div>
    <div>
      <p class="pb-10 text-[0.65rem] font-semibold uppercase tracking-[0.45em] text-neutral-600">{t(locale, "footer.info")}</p>
      <nav class="space-y-4 text-neutral-400">
        <a class="block hover:text-brand" href={localizePath(locale, "about")}>{t(locale, "footer.story")}</a>
        <a class="block hover:text-brand" href={localizePath(locale, "contact")}>{t(locale, "nav.contact")}</a>
        <a
          class="block hover:text-brand"
          href={`https://wa.me/${site.whatsappE164.replace(/\D+/g, "")}`}
          target="_blank"
          rel="noreferrer noopener"
        >
          {t(locale, "footer.linkWhatsApp")}
        </a>
      </nav>
    </div>
    <div>
      <p class="pb-10 text-[0.65rem] font-semibold uppercase tracking-[0.45em] text-neutral-600">{t(locale, "footer.legal")}</p>
      <nav class="space-y-4 text-neutral-400">
        <a class="block hover:text-brand" href={localizePath(locale, "privacyPolicy")}>{t(locale, "footer.privacy")}</a>
        <a class="block hover:text-brand" href={localizePath(locale, "termsAndConditions")}>{t(locale, "footer.terms")}</a>
      </nav>
    </div>
    <div>
      <p class="pb-10 text-[0.65rem] font-semibold uppercase tracking-[0.45em] text-neutral-600">{t(locale, "footer.socials")}</p>
      <nav class="space-y-4 text-neutral-400">
        <a class="block hover:text-brand" href={site.instagramUrl} target="_blank" rel="noreferrer noopener">
          Instagram
        </a>
        <a class="block hover:text-brand" href={site.facebookUrl} target="_blank" rel="noreferrer noopener">
          Facebook
        </a>
        <a class="block hover:text-brand" href={site.linkedInUrl} target="_blank" rel="noreferrer noopener">
          LinkedIn
        </a>
      </nav>
    </div>
  </div>
  <div class="mx-auto mt-24 flex max-w-6xl flex-col gap-6 border-t border-white/15 px-4 pt-10 text-neutral-500 text-sm md:flex-row md:items-center md:justify-between sm:px-6">
    <p>© {new Date().getFullYear()} Iguana Comedy. {t(locale, "footer.copyright")}.</p>
    <div class="flex gap-4 text-neutral-500">
      <a href={localizePath(locale, "store")} class="hover:text-brand">
        {t(locale, "nav.merch")}
      </a>
    </div>
  </div>
</footer>
