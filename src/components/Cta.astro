---
import { t } from "../i18n/ui";
import type { Locale } from "../i18n/locale";
import { localizePath } from "../i18n/routes";

const { eyebrow: eyebrowProp, headline: headlineProp, ctaHref: ctaHrefProp, secondaryHref: secondaryHrefProp, secondaryLabel: secondaryLabelProp, body, locale = "en" } =
  Astro.props as {
    eyebrow?: string;
    headline?: string;
    ctaHref?: string;
    secondaryHref?: string;
    secondaryLabel?: string;
    body?: string;
    locale?: Locale;
  };

const eyebrow = eyebrowProp ?? t(locale, "cta.eyebrow.tickets");
const headline = headlineProp ?? t(locale, "cta.headline.readyToLaugh");
const secondaryLabel = secondaryLabelProp ?? t(locale, "cta.secondaryLabel.talkWithUs");
const ctaHref = ctaHrefProp ?? localizePath(locale, "events");
const secondaryHref = secondaryHrefProp ?? localizePath(locale, "contact");
---

<section class="relative isolate overflow-hidden bg-brand py-20 text-neutral-950">
  <!-- One centred column: the headline and its buttons used to sit at opposite ends of the band. -->
  <div class="mx-auto flex max-w-page flex-col items-center gap-8 px-6 text-center">
    <p class="text-xs font-semibold uppercase tracking-[0.45em] text-neutral-900/85">{eyebrow}</p>
    <h2 class="font-display text-4xl text-neutral-950 sm:text-[clamp(3rem,4vw,4.65rem)]" style={`font-family: var(--font-display);`}>{headline}</h2>
    {body ? <p class="max-w-2xl text-lg text-neutral-900/95">{body}</p> : null}
    <div class="flex flex-col items-center gap-4">
      <a
        href={ctaHref}
        class="rounded-[2rem] bg-neutral-950 px-14 py-[1.05rem] text-center text-[0.7rem] font-semibold uppercase tracking-[0.35em] text-white"
      >
        {t(locale, "ui.buyTickets")}
      </a>
      <a href={secondaryHref} class="text-center text-[0.7rem] font-semibold uppercase tracking-[0.35em] text-neutral-950/95 underline underline-offset-[0.5rem]">
        {secondaryLabel}
      </a>
    </div>
  </div>
</section>
