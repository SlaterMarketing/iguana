---
import type { Locale } from "../../i18n/locale";
import { t } from "../../i18n/ui";

interface Props {
  faq: ReadonlyArray<{ question: string; answer: string; open?: boolean }>;
  locale?: Locale;
}

const { faq, locale = "en" } = Astro.props;
---

<div class="mx-auto max-w-4xl">
  <h2
    class="text-center font-display text-4xl uppercase leading-[1.05] text-neutral-950 sm:text-5xl lg:text-6xl"
    style="font-family: var(--font-display);"
  >
    {t(locale, "events.faqTitle")}
  </h2>
  <div class="mt-12 divide-y divide-black/10 border-t border-black/10">
    {
      faq.map((item) => (
        <details class="group py-8" open={item.open ? true : undefined}>
          <summary class="flex cursor-pointer list-none items-center justify-center gap-4 font-display text-xl text-neutral-950 sm:text-2xl" style="font-family: var(--font-display);">
            <span>{item.question}</span>
            <span class="shrink-0 text-2xl text-brand transition group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-neutral-700">{item.answer}</p>
        </details>
      ))
    }
  </div>
</div>

<style>
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
