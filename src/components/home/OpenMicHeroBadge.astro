---
import type { KintanaPublicEvent } from "@kintana/sdk";

import type { Locale } from "../../i18n/locale";
import { localizePath } from "../../i18n/routes";
import { t } from "../../i18n/ui";
import { combinedRecentLine, demandLine } from "../../lib/demand";
import { formatSeatPrice, nextBookableOpenMics } from "../../lib/open-mics";

interface Props {
  locale: Locale;
  /** Upcoming events the home page already loaded. */
  events: KintanaPublicEvent[];
}

const { locale, events } = Astro.props;
const next = nextBookableOpenMics(events);
// Each button says the night, its language and the price (short day names on phones so both fit on one row); the
// caption explains they reserve a seat, and aria-label keeps the full sentence for screen readers.
const nights = [
  {
    day: t(locale, "openMic.hero.tuesday"),
    dayShort: t(locale, "openMic.hero.tuesdayShort"),
    language: t(locale, "openMic.hero.spanish"),
    label: t(locale, "openMic.hero.reserveTuesday"),
    event: next.es,
  },
  {
    day: t(locale, "openMic.hero.wednesday"),
    dayShort: t(locale, "openMic.hero.wednesdayShort"),
    language: t(locale, "openMic.hero.english"),
    label: t(locale, "openMic.hero.reserveWednesday"),
    event: next.en,
  },
].flatMap((night) =>
  night.event
    ? [{ ...night, event: night.event, price: formatSeatPrice(night.event, locale), demand: demandLine(night.event, locale) }]
    : [],
);
// Somebody else is already coming. Normally that is one line about both nights added together, because a line
// per night says the same sentence twice under two buttons. A night that is genuinely nearly full is the
// exception: that has to be named, or the visitor cannot tell which night to hurry for.
const tight = nights.filter((night) => night.demand?.tight);
const combined = tight.length ? null : combinedRecentLine(nights.map((night) => night.event), locale);
const pressure = combined
  ? [{ day: "", text: combined, tight: false }]
  : nights.flatMap((night) => (night.demand ? [{ day: night.dayShort, text: night.demand.text, tight: night.demand.tight }] : []));
const buttonClass =
  "inline-flex items-center gap-2 sm:gap-3 whitespace-nowrap rounded-2xl border border-white/40 bg-black/30 px-3 py-2 text-left font-semibold uppercase text-white backdrop-blur transition hover:bg-white hover:text-neutral-950 sm:px-5";

// "{free}" marks where the highlighted word goes, so each language keeps its own word order.
const [beforeFree, afterFree = ""] = t(locale, "openMic.hero.title").split("{free}");
---

<div class="mt-6 flex flex-col items-center gap-3 sm:mt-10 sm:gap-4" data-open-mic-hero>
  <p
    class="whitespace-nowrap font-display leading-none tracking-wide text-white text-[clamp(1.1rem,5.3vw,2.75rem)]"
    style="font-family: var(--font-display);"
  >
    {beforeFree}<span class="inline-block rounded-lg bg-amber-400 px-3 pt-[0.12em] text-neutral-950 shadow-lg shadow-black/30"
      >{t(locale, "openMic.hero.free")}</span
    >{afterFree}
  </p>
  {
    nights.length > 0 && (
      <p class="text-[0.62rem] font-semibold uppercase tracking-[0.25em] text-white/80 sm:text-xs">{t(locale, "openMic.hero.caption")}</p>
    )
  }
  <div class="flex flex-wrap justify-center gap-2 sm:gap-3">
    {
      nights.length ? (
        nights.map((night) => (
          <a
            class={buttonClass}
            aria-label={`${night.label} · ${night.price}`}
            href={localizePath(locale, "eventDetail", { slug: night.event.slug })}
          >
            <span class="flex flex-col gap-0.5 leading-tight">
              <span class="text-[0.66rem] tracking-[0.14em] sm:text-[0.72rem] sm:tracking-[0.2em]">
                <span class="sm:hidden">{night.dayShort}</span><span class="hidden sm:inline">{night.day}</span> · {night.language}
              </span>
              <span class="text-[0.6rem] tracking-[0.14em] opacity-75 sm:text-[0.65rem] sm:tracking-[0.2em]">{night.price}</span>
            </span>
            <span aria-hidden="true">→</span>
          </a>
        ))
      ) : (
        <a class={buttonClass} href={localizePath(locale, "events")}>
          <span class="text-[0.66rem] tracking-[0.14em] sm:text-[0.72rem] sm:tracking-[0.2em]">{t(locale, "openMic.hero.seeDates")}</span>
          <span aria-hidden="true">→</span>
        </a>
      )
    }
  </div>
  {
    pressure.length > 0 && (
      <div class="flex flex-col items-center gap-1">
        {pressure.map((row) => (
          <p
            class:list={[
              "text-[0.62rem] font-semibold uppercase tracking-[0.18em] sm:text-[0.7rem] sm:tracking-[0.22em]",
              row.tight ? "text-amber-300" : "text-white/75",
            ]}
          >
            {row.day ? `${row.day} · ` : ""}{row.text}
          </p>
        ))}
      </div>
    )
  }
</div>
