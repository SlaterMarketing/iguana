---
const { value, suffix = "", label } = Astro.props as {
  value: number;
  suffix?: string;
  label: string;
};

const labelText = `${value}${suffix}`;
---

<div
  class="stat-counter px-2 py-2 text-center sm:px-4 sm:text-left"
  data-stat-value={value}
  data-stat-suffix={suffix}
>
  <p class="text-xs font-semibold uppercase tracking-[0.35em] text-neutral-500">{label}</p>
  <p class="mt-3 font-display text-3xl text-brand-hover sm:text-4xl lg:text-[2.9rem]" style="font-family: var(--font-display);">
    <span class="stat-counter__value" aria-hidden="true">0{suffix}</span>
    <span class="sr-only">{labelText}</span>
  </p>
</div>
