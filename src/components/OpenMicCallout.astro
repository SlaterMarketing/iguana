---
import type { KintanaPublicEvent } from "@kintana/sdk";

import type { Locale } from "../i18n/locale";
import { localizePath } from "../i18n/routes";
import { site } from "../content/site";
import { formatEventDate } from "../lib/events";
import { holidayNotice } from "../lib/holiday-notice";
import { formatSeatPrice, nextBookableOpenMics } from "../lib/open-mics";

interface Props {
  locale: Locale;
  class?: string;
  /** Upcoming events already loaded by the page; used to link each night to its next bookable date. */
  events?: KintanaPublicEvent[];
}

const { locale, class: className, events = [] } = Astro.props;

// Null on any day outside a closure, so the banner takes itself down.
const notice = holidayNotice(locale);
const next = nextBookableOpenMics(events);

const mapsHref = site.venueMapsUrl;

const copy = {
  en: {
    kicker: "Every week",
    headline: "Open mic nights",
    free: "Free entry",
    nights: [
      { day: "Tuesday", show: "Open mic in Spanish", event: next.es },
      { day: "Wednesday", show: "Open mic in English", event: next.en },
    ],
    reserve: "Reserve",
    perSeat: "per seat, includes a free drink",
    nextNight: "Next",
    reserveNote:
      "Entry is always free, but walk-ins may be turned away when we are full. A reservation guarantees your seat and includes a free drink. Arrive when doors open.",
    venue: "At Iguana Comedy, Playa del Carmen",
    maps: "Directions",
  },
  es: {
    kicker: "Cada semana",
    headline: "Noches de open mic",
    free: "Entrada gratis",
    nights: [
      { day: "Martes", show: "Open mic en español", event: next.es },
      { day: "Miércoles", show: "Open mic en inglés", event: next.en },
    ],
    reserve: "Reservar",
    perSeat: "por lugar, incluye una bebida gratis",
    nextNight: "Próximo",
    reserveNote:
      "La entrada siempre es gratis, pero sin reservación podemos negarte el paso si se llena. Tu reservación te garantiza un lugar e incluye una bebida gratis. Llega a la hora de apertura de puertas.",
    venue: "En Iguana Comedy, Playa del Carmen",
    maps: "Cómo llegar",
  },
}[locale];

const canReserve = copy.nights.some((night) => night.event);
---

<aside
  id="open-mic"
  class:list={["overflow-hidden rounded-[2rem] bg-neutral-950 text-white", className]}
  aria-label={copy.headline}
>
  {
    notice && (
      <div class="space-y-1 bg-amber-400 px-8 py-5 text-neutral-950 sm:px-12">
        <p class="text-sm font-semibold uppercase tracking-[0.25em]">{notice.headline}</p>
        <p class="text-sm leading-relaxed">{notice.detail}</p>
      </div>
    )
  }

  <div class="mx-auto max-w-4xl px-6 py-10 text-center sm:px-10">
    <p class="text-xs font-semibold uppercase tracking-[0.45em] text-white/60">{copy.kicker}</p>
    <p
      class="mt-3 font-display leading-none"
      style="font-family: var(--font-display); font-size: clamp(2.25rem, 3vw + 1.25rem, 3.25rem);"
    >
      {copy.headline}
    </p>
    <p class="mt-4 inline-flex rounded-full bg-brand px-4 py-1.5 text-sm font-semibold uppercase tracking-[0.2em]">
      {copy.free}
    </p>

    {/* The whole night is one target: the card itself is the link, with the button inside it as the affordance. */}
    <ul class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        copy.nights.map((night) =>
          night.event ? (
            <li>
              <a
                class="group flex h-full flex-col items-center rounded-2xl border border-white/20 bg-white/[0.03] px-6 py-6 transition hover:border-white/70 hover:bg-white/10 focus-visible:border-white/70 focus-visible:outline-none"
                href={localizePath(locale, "eventDetail", { slug: night.event.slug })}
              >
                <span class="text-xs font-semibold uppercase tracking-[0.35em] text-white/60">{night.day}</span>
                <span class="mt-2 text-lg font-semibold">{night.show}</span>
                <span class="mt-2 text-sm text-white/70">
                  {copy.nextNight}: {formatEventDate(night.event.date, locale)}
                  <br />
                  {formatSeatPrice(night.event, locale)} {copy.perSeat}
                </span>
                <span class="mt-5 inline-flex items-center gap-2 rounded-full bg-white px-6 py-2.5 text-xs font-semibold uppercase tracking-[0.3em] text-neutral-950 transition group-hover:bg-brand group-hover:text-white">
                  {copy.reserve}
                  <span aria-hidden="true">→</span>
                </span>
              </a>
            </li>
          ) : (
            <li class="flex h-full flex-col items-center rounded-2xl border border-white/15 px-6 py-6">
              <span class="text-xs font-semibold uppercase tracking-[0.35em] text-white/60">{night.day}</span>
              <span class="mt-2 text-lg font-semibold">{night.show}</span>
            </li>
          ),
        )
      }
    </ul>

    {canReserve && <p class="mx-auto mt-6 max-w-2xl text-sm leading-relaxed text-white/70">{copy.reserveNote}</p>}
  </div>

  <a
    class="flex flex-wrap items-center justify-center gap-3 border-t border-white/10 px-6 py-5 text-sm text-white/75 transition hover:bg-white/5 hover:text-white sm:px-10"
    href={mapsHref}
    rel="noopener"
    target="_blank"
  >
    <span>{copy.venue}</span>
    <span class="font-semibold uppercase tracking-[0.3em] text-white">{copy.maps} →</span>
  </a>
</aside>
