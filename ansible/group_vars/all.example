# Copy to group_vars/all (gitignored, mode 600). Secrets come from ~/.credentials via lookup, never literals.
creds: "~/.credentials/vpsorg/iguanacomedy"
deploy_user: iguana
ansible_user: iguana
deploy_password: "{{ lookup('file', creds + '/password') }}"
ansible_become_password: "{{ deploy_password }}"
projectname: iguana
app_dir: /home/www/iguana
# Canonical site. iguanacomedy.com DNS is on Cloudflare (DNS-only records, token in ~/.credentials/cloudflare/iguanacomedy).
site_domain: iguanacomedy.com
api_domain: api.iguanacomedy.com
# Interim domain from before .com was recovered: the site 301s to .com, the API keeps answering.
redirect_domains: [iguanacomedy.mx]
api_alias_domains: [api.iguanacomedy.mx]
# Mail stays on the .mx zone (VPS.org DNS), where MX/SPF/DKIM/DMARC/PTR are set up and verified.
mail_zone: iguanacomedy.mx
mail_zones: [iguanacomedy.mx, iguanacomedy.com]
mail_domain: mail.iguanacomedy.mx
cert_sets:
  - {name: iguanacomedy.com, domains: [iguanacomedy.com, www.iguanacomedy.com]}
  - {name: api.iguanacomedy.com, domains: [api.iguanacomedy.com]}
  - {name: iguanacomedy.mx, domains: [iguanacomedy.mx, www.iguanacomedy.mx]}
  - {name: api.iguanacomedy.mx, domains: [api.iguanacomedy.mx]}
  - {name: mail.iguanacomedy.mx, domains: [mail.iguanacomedy.mx]}
server_ipv4: 38.86.78.36
server_ipv6: "2001:550:2:dd::f9:68"
certbot_email: hello@iguanacomedy.com
db_name: iguana
db_user: iguana
db_password: "{{ lookup('file', creds + '/db_password') }}"
django_secret_key: "{{ lookup('file', creds + '/django_secret_key') }}"
public_api_key: "{{ lookup('file', creds + '/public_api_key') }}"
secret_api_key: "{{ lookup('file', creds + '/secret_api_key') }}"
notify_emails: ["hello@iguanacomedy.com"]
# DNS is live (ns1-3.vps.org) since 2026-09-14. Set false only to serve by IP (site :80, API :8080).
dns_live: true
site_url: "{{ ('https://' + site_domain) if dns_live | bool else ('http://' + server_ipv4) }}"
backend_url: "{{ ('https://' + api_domain) if dns_live | bool else ('http://' + server_ipv4 + ':8080') }}"
site_urls: "{{ ([site_url, 'https://www.' + site_domain] + (redirect_domains | map('regex_replace', '^', 'https://') | list)) if dns_live | bool else [site_url] }}"

# Mail: people's addresses deliver to the local `inbox` user AND forward to mail_forwards; role/DSN addresses
# deliver locally only, so bounce noise stays off the forwards. Nothing ever forwards INSTEAD of delivering:
# the local copy is what survives if a forward is rejected. DMARC reports go to the local `dmarc` user.
mail_human_aliases: [hello, info, bills, andrew, john, will, will.slater]
mail_role_aliases: [noreply, no-reply, postmaster, abuse, mailer-daemon]
mail_forwards: [someone@example.com, someone-else@example.com]
mail_test_recipient: someone-else@example.com

# DB-IP "IP to City Lite" (CC BY 4.0), refreshed monthly by iguana-geoip-refresh; read by backend/crm/geo.py.
geoip_db: /var/lib/iguana/dbip-city-lite.mmdb

# Clicky analytics through a first-party proxy (https://clicky.com/help/proxy). Paths are random per site.
clicky_site_id: "101511754"
clicky_js_path: /ce3c4461b3c804.js
clicky_beacon_path: /d3459242368652
